const hl=id=>document.querySelectorAll('.tb').forEach(b=>b.classList.toggle('on',b.id===id));
const starS=n=>'<span class="st">'+'★'.repeat(n)+'</span>';
const R=new T.WebGLRenderer({canvas:$('c'),antialias:true});R.setPixelRatio(Math.min(devicePixelRatio,2));R.shadowMap.enabled=true;R.shadowMap.type=T.PCFSoftShadowMap;
const sc=new T.Scene();sc.background=new T.Color(0x05050f);sc.fog=new T.Fog(0x05050f,70,190);const cam=new T.PerspectiveCamera(40,1,.1,300);
const hemi=new T.HemisphereLight(0xffd9b0,0x2a2018,.3);sc.add(hemi);
const dl=new T.DirectionalLight(0xffc98a,.28);dl.position.set(-10,22,14);dl.castShadow=true;dl.shadow.normalBias=.03;dl.shadow.mapSize.set(2048,2048);Object.assign(dl.shadow.camera,{left:-34,right:34,top:34,bottom:-34,near:1,far:90});sc.add(dl);

/* ===== cahaya mengikuti jam asli HP: pagi, siang, sore, malam ===== */
const LK=[ /* jam, langit, hemi atas, hemi bawah, kuat hemi, warna matahari, kuat matahari */
[0,0x0c1430,0x8090c8,0x2a3450,.75,0x9fb4ff,.28],
[5,0x1a2347,0x8090c8,0x2a3450,.72,0xa8b8ff,.28],
[6,0xf2a678,0xffd2a8,0x6e7a52,.45,0xffa860,.7],
[7.5,0xb5cfe6,0xf2ecdc,0x7d8a5c,.5,0xffe2b8,.75],
[10,0xa6d2f0,0xeef4ff,0x84925e,.5,0xfff4dc,.75],
[14,0xa0cfee,0xeef4ff,0x84925e,.5,0xfff6e6,.75],
[17,0xb2cbdc,0xfff0dc,0x7d8a5c,.5,0xffd9a8,.72],
[18.3,0xf08a58,0xffbf94,0x6a6a4c,.45,0xff8040,.65],
[19.5,0x3d3a6e,0x8078b0,0x2c3040,.6,0xa088c8,.3],
[21,0x0c1430,0x8090c8,0x2a3450,.75,0x9fb4ff,.28],
[24,0x0c1430,0x8090c8,0x2a3450,.75,0x9fb4ff,.28]];
let lightTest=null;const lc=new T.Color();
function applyLight(){
 const d=new Date(),h=lightTest!=null?lightTest:d.getHours()+d.getMinutes()/60;
 let i=0;while(i<LK.length-2&&h>=LK[i+1][0])i++;
 const a=LK[i],b=LK[i+1],k=Math.min(1,Math.max(0,(h-a[0])/(b[0]-a[0])));
 sc.background.set(a[1]).lerp(lc.set(b[1]),k);sc.fog.color.copy(sc.background);
 hemi.color.set(a[2]).lerp(lc.set(b[2]),k);hemi.groundColor.set(a[3]).lerp(lc.set(b[3]),k);hemi.intensity=a[4]+(b[4]-a[4])*k;
 dl.color.set(a[5]).lerp(lc.set(b[5]),k);dl.intensity=a[6]+(b[6]-a[6])*k;
 let sunUp=0;
 if(h>=6&&h<=18.5){const p=(h-6)/12.5,el=.3+.7*Math.sin(Math.PI*p);dl.position.set((Math.cos(Math.PI*p)*.8+.35)*30*Math.cos(el),Math.sin(el)*30,10+8*Math.cos(el));sunUp=Math.min(1,Math.sin(Math.PI*p)*3)}else dl.position.set(-8,26,12);
 sunPatches(sunUp);updLamps()}
/* bercak sinar matahari yang masuk lewat jendela (seperti di The Sims) */
const LP=[0,1,2].map(()=>{const l=new T.PointLight(0xffd9a0,0,5.5,1.6);sc.add(l);return l});
function updLamps(){const a=slots.filter(q=>q.t=='r'&&q.g&&(items[q.k]||0)>=3&&owned[q.r]);LP.forEach((l,i)=>{const q=a[i];if(q){l.position.set(q.x-1.6,1.6,q.z-.4);l.intensity=1.15}else l.intensity=0})}
let SWIN=[];const pg=new T.Group();sc.add(pg);let patchM=null;const Lv=new T.Vector3();
function sunPatches(up){
 for(const m of [...pg.children]){pg.remove(m);m.geometry.dispose()}
 if(up<=.02||!SWIN.length)return;
 if(!patchM)patchM=new T.MeshBasicMaterial({map:cvT(128,(g,n)=>{g.fillStyle='rgb(255,226,140)';[[10,10],[69,10],[10,69],[69,69]].forEach(([x,y])=>g.fillRect(x,y,49,49))},1,1),transparent:true,blending:T.AdditiveBlending,depthWrite:false,side:T.DoubleSide});
 patchM.opacity=.75*up;Lv.copy(dl.position).normalize().negate();
 SWIN.forEach(w=>{if(Lv.x*w.inx+Lv.z*w.inz<.08)return;
  const tx=w.inz?1:0,tz=w.inx?1:0,P=[];
  [[-.9,.7],[.9,.7],[.9,1.9],[-.9,1.9]].forEach(([u,y])=>{const qx=w.x+tx*u+w.inx*.125,qz=w.z+tz*u+w.inz*.125,t=(y-.05)/-Lv.y;P.push(Math.min(w.ox+7.85,Math.max(w.ox+.15,qx+Lv.x*t)),.05,Math.min(w.oz+5.85,Math.max(w.oz+.15,qz+Lv.z*t)))});
  const g=new T.BufferGeometry();g.setAttribute('position',new T.Float32BufferAttribute(P,3));g.setAttribute('uv',new T.Float32BufferAttribute([0,0,1,0,1,1,0,1],2));g.setIndex([0,1,2,0,2,3]);
  const m=new T.Mesh(g,patchM);m.renderOrder=2;pg.add(m)})}
const pv=new T.Scene();pv.background=new T.Color(0x0c2a4d);pv.add(new T.HemisphereLight(0xffffff,0x88aacc,1));const pd=new T.DirectionalLight(0xffffff,.6);pd.position.set(2,4,5);pv.add(pd);
const ccam=new T.PerspectiveCamera(30,1,.1,50),pcam=new T.PerspectiveCamera(26,.7,.1,30);ccam.position.set(0,1.1,6);ccam.lookAt(0,1,0);pcam.position.set(0,1.62,3.4);pcam.lookAt(0,1.55,0);
const mats={},M=c=>typeof c=='number'?(mats[c]||(mats[c]=new T.MeshLambertMaterial({color:c}))):c,E=c=>mats['e'+c]||(mats['e'+c]=new T.MeshBasicMaterial({color:c}));
const mk=(g,geo,x,y,z,c)=>{const m=new T.Mesh(geo,M(c));m.position.set(x,y,z);m.castShadow=m.receiveShadow=true;g.add(m);return m};
const B=(g,w,h,d,x,y,z,c)=>mk(g,new T.BoxGeometry(w,h,d),x,y+h/2,z,c),C=(g,r,h,x,y,z,c,r2)=>mk(g,new T.CylinderGeometry(r2??r,r,h,16),x,y+h/2,z,c),Sp=(g,r,x,y,z,c)=>mk(g,new T.SphereGeometry(r,14,10),x,y,z,c);
function label(t,bg,w,h,fs){const c=document.createElement('canvas');c.width=1024;c.height=Math.round(1024*h/w);const g=c.getContext('2d');g.fillStyle=bg;g.beginPath();(g.roundRect||g.rect).call(g,6,6,c.width-12,c.height-12,c.height/2);g.fill();g.lineWidth=7;g.strokeStyle='rgba(150,225,255,.9)';g.stroke();
 g.fillStyle='#fff';g.font='bold '+fs+'px sans-serif';g.textAlign='center';g.textBaseline='middle';g.fillText(t,c.width/2,c.height/2+4);
 const s=new T.Sprite(new T.SpriteMaterial({map:new T.CanvasTexture(c),depthTest:false,transparent:true}));s.scale.set(w,h,1);s.renderOrder=9;return s}

