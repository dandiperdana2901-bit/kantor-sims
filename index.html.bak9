const SKIN=[0xffdcc4,0xf1c27d,0xd9a066,0xb8774a,0x8d5524,0x5c3a21],HAIRC=[0x2b1d14,0x6b3d1e,0xe0b050,0xff6a2f,0xd96aa0,0x5a7bd9,0xeeeeee],SHIRT=[0x222222,0xff7eb6,0x4f9dff,0x66cc77,0xffd24a,0x9b7cff,0xffffff,0xe84a4a],PANTS=[0x2b2b3a,0x4b6a9b,0x8a6a4a,0x555555,0xeeeeee,0x6a3a4a];
const NM='Kiro Ren Yuki Haru Luna Aiko Emi Riku Kanna Shin Kenji Nami Daiki Mei Fumi Rei Itsuki Hina Ryo Noa Saki Yuna Kota Momo Alex Niko Mika Sora Akira Taro'.split(' ');
function makeSim(o){const g=new T.Group(),f=o.body,sk=o.skin;
 const legs=[-1,1].map(s=>{const h=new T.Group();h.position.set(s*.1,.95,0);g.add(h);C(h,.085,.45,0,-.45,0,o.pants,.095);const k=new T.Group();k.position.y=-.45;h.add(k);C(k,.07,.43,0,-.43,0,o.pants,.085);B(k,.13,.07,.26,0,-.5,.06,0xf2f2f2);return{h,k}});
 C(g,f?.22:.2,.62,0,.95,0,o.shirt,f?.19:.25);C(g,.06,.1,0,1.57,0,sk);
 const arms=[-1,1].map(s=>{const a=new T.Group();a.position.set(s*(f?.24:.29),1.52,0);g.add(a);C(a,.06,.22,0,-.22,0,o.shirt,.07);C(a,.045,.32,0,-.52,0,sk,.05);Sp(a,.05,0,-.55,0,sk);a.rotation.z=s*.1;return a});
 const hd=new T.Group();hd.position.y=1.8;g.add(hd);Sp(hd,.2,0,0,0,sk).scale.y=1.12;
 [-1,1].forEach(s=>{Sp(hd,.038,s*.075,.02,.17,0xffffff);Sp(hd,.02,s*.075,.02,.205,0x2a2a3a);B(hd,.07,.015,.02,s*.075,.07,.19,o.hc);Sp(hd,.04,s*.2,0,0,sk)});
 Sp(hd,.03,0,-.03,.2,sk);B(hd,.07,.015,.01,0,-.09,.19,0xb34a5a);const hs=o.hs,hc=o.hc;
 mk(hd,new T.SphereGeometry(.215,16,10,0,6.3,0,hs==0?1.55:1.75),0,.04,-.01,hc);
 if(hs==0)[[0,.25,.05],[.1,.24,0],[-.1,.24,0],[0,.24,-.1],[.06,.26,.12]].forEach(p=>mk(hd,new T.ConeGeometry(.06,.16,6),p[0],p[1],p[2],hc));
 if(hs==1)B(hd,.44,.55,.12,0,-.45,-.15,hc);if(hs==2)Sp(hd,.1,0,.27,-.1,hc);if(hs==3)B(hd,.42,.26,.1,0,-.15,-.17,hc);
 return{g,hd,arms,legs}}
function makeSim(o){const g=new T.Group(),f=o.body,V=T.Vector2,
 st=(c,r=.7)=>new T.MeshStandardMaterial({color:c,roughness:r,metalness:0}),sk=st(o.skin,.55),sh=st(o.shirt,.8),pn=st(o.pants,.85),hr=st(o.hc,.4),shoe=st(0xf4f4f6,.5);
 const S=(r,w=16,h=12)=>new T.SphereGeometry(r,w,h),lat=(pts,seg=18)=>new T.LatheGeometry(pts.map(a=>new V(a[0],a[1])),seg);
 const add=(p,geo,m,x=0,y=0,z=0,sx=1,sy=1,sz=1)=>{const q=new T.Mesh(geo,m);q.position.set(x,y,z);q.scale.set(sx,sy,sz);q.castShadow=q.receiveShadow=true;p.add(q);return q};
 const legs=[-1,1].map(s=>{const h=new T.Group();h.position.set(s*(f?.095:.1),.95,0);g.add(h);
  add(h,lat([[.05,-.45],[.065,-.35],[.09,-.2],[.105,-.06],[.1,0]]),pn);add(h,S(.07),pn,0,-.45);
  const k=new T.Group();k.position.y=-.45;h.add(k);add(k,lat([[.035,-.43],[.045,-.36],[.065,-.22],[.075,-.1],[.07,0]]),pn);add(k,S(.065),shoe,0,-.46,.05,1.1,.7,2.1);return{h,k}});
 add(g,lat(f?[[0,0],[.2,0],[.215,.07],[.17,.3],[.19,.45],[.215,.55],[.19,.62],[.09,.66],[0,.67]]:[[0,0],[.18,0],[.2,.08],[.19,.3],[.225,.46],[.25,.56],[.21,.63],[.09,.67],[0,.68]],24),sh,0,.95,0,1,1,.62);
 add(g,S(.12),pn,0,.95,0,1.4,.8,.9);if(f)[-1,1].forEach(s=>add(g,S(.075),sh,s*.085,1.4,.1,1,1,.9));
 add(g,new T.TorusGeometry(.072,.018,8,18),sh,0,1.6,0).rotation.x=Math.PI/2;add(g,lat([[.05,0],[.055,.06],[.052,.14]]),sk,0,1.55,0);
 const arms=[-1,1].map(s=>{const a=new T.Group();a.position.set(s*(f?.23:.285),1.5,0);g.add(a);add(a,S(.07),sh);add(a,lat([[.056,-.2],[.062,-.1],[.072,-.02]]),sh);
  add(a,lat([[.03,-.5],[.037,-.42],[.05,-.28],[.058,-.2]]),sk);add(a,S(.05),sk,0,-.2);add(a,S(.045),sk,0,-.53,.01,.9,1.3,.7);a.rotation.z=s*.1;return a});
 const hd=new T.Group();hd.position.y=1.76;hd.scale.setScalar(.88);g.add(hd);
 const hg=S(.2,32,24),pa=hg.attributes.position;for(let i=0;i<pa.count;i++){let x=pa.getX(i),y=pa.getY(i),z=pa.getZ(i);if(y<0){const k=1+y*1.2;x*=k;z*=.55+.45*k}pa.setXYZ(i,x,y*1.15,z)}hg.computeVertexNormals();add(hd,hg,sk);
 [-1,1].forEach(s=>{const e=new T.Group();e.position.set(s*.072,.03,.165);hd.add(e);add(e,S(.036),st(0xffffff,.3),0,0,0,1,.85,.55);add(e,S(.021),st(o.eye||0x5a3a22,.3),0,0,.012);add(e,S(.011),st(0x111111,.2),0,0,.021);add(e,S(.006),st(0xffffff,.1),.007,.007,.026);
  add(hd,S(.05),sk,s*.195,-.01,0,.4,1,.7);const br=add(hd,new T.BoxGeometry(.075,.014,.02),hr,s*.075,.088,.185);br.rotation.z=-s*.12;
  add(hd,S(.04),new T.MeshBasicMaterial({color:0xff7a8a,transparent:true,opacity:.28}),s*.11,-.04,.155,1,.7,.3)});
 add(hd,S(.026),sk,0,-.02,.2,.8,1,1.2);add(hd,S(.03),st(0xc4566a,.5),0,-.085,.182,1.5,.45,.7);add(hd,S(.03),st(0xd8697b,.5),0,-.1,.18,1.35,.5,.7);
 const hs=o.hs;add(hd,new T.SphereGeometry(.212,32,20,0,6.3,0,1.25),hr,0,.02,-.015,1,1.12,1.02);
 [-1,1].forEach(s=>{if(hs==0)add(hd,S(.05),hr,s*.19,.04,-.02,.4,1.4,.9)});
 if(hs==0){add(hd,S(.11),hr,0,.26,.1,1.4,1,1.7);[-1,1].forEach(s=>add(hd,S(.07),hr,s*.12,.23,0,1,1,1.3))}
 else{add(hd,S(.2),hr,0,.15,.1,1,.4,.75);
