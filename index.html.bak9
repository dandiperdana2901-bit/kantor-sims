  if(!sh&&sd!='s')(sd=='n'?[-2,2]:[0]).forEach(o=>addWin(g,sd,hz?cx+o:cx,hz?cz:cz+o,ox,oz));
  if(i==0&&sd=='s'){B(g,2.3,.04,.9,cx,0,cz+.6,0x9a4a2a);B(g,.14,2.4,.3,cx-1.05,0,cz,0x7a5238);B(g,.14,2.4,.3,cx+1.05,0,cz,0x7a5238)}
  WL.push({g,cx:hz?(a+b)/2:fx,cz:hz?fx:(a+b)/2,sh,nx:sh?0:sd=='w'?-1:sd=='e'?1:0,nz:sh?0:sd=='n'?-1:sd=='s'?1:0})});
 const rf=new T.Mesh(new T.BoxGeometry(R4[1]-R4[0],.1,R4[3]-R4[2]),RFM);rf.position.set((R4[0]+R4[1])/2,2.55,(R4[2]+R4[3])/2);rf.castShadow=true;wg.add(rf)}applyLight()}
applyLight();setInterval(applyLight,15000);

/* ===== perabot ===== */
function mkDesk(l){const g=new T.Group(),tc=[0xd9a066,0xffffff,0x2b2b3a,0x1c1c28][l-1],s_=[0x7ec8ff,0x9fe3ff,0xff7ee0,0x7effc8][l-1];
 B(g,2.2,.1,1,0,.72,0,tc);B(g,.1,.72,.9,-1,0,0,tc);B(g,.1,.72,.9,1,0,0,tc);const n=[1,1,2,3][l-1];
 for(let i=0;i<n;i++){const x=(i-(n-1)/2)*.75;B(g,.7,.45,.05,x,.84,-.25,0x20202c);B(g,.62,.37,.02,x,.88,-.22,E(s_))}
 B(g,.6,.03,.2,0,.82,.2,0x39394a);B(g,.12,.12,.12,.8,.82,.25,0xffffff);if(l>=3)B(g,2.2,.03,.03,0,.68,.48,0xd04fa8);
 C(g,.32,.1,0,.42,1.1,0x4aa8e8);B(g,.6,.55,.1,0,.5,1.38,0x4aa8e8);C(g,.05,.42,0,0,1.1,0x666666);return g}
function mkDeco(l){const g=new T.Group();C(g,.3,.4,0,0,0,0xe8a07e,.38);for(let i=0;i<l+2;i++){const a=i*2.4;Sp(g,.32,Math.cos(a)*.22,.55+i*.2,Math.sin(a)*.22,i%2?0x5cb86a:0x7ad085)}
 if(l>1)for(let i=0;i<l*2;i++){const a=i*1.7;Sp(g,.07,Math.cos(a)*.4,.7+i*.1,Math.sin(a)*.4,0xff7eb0)}g.scale.setScalar(1+.25*l);return g}
function mkRest(l){const g=new T.Group();B(g,2.4,.45,1.1,0,0,0,0xff9fc4);B(g,2.4,.6,.3,0,.45,-.45,0xff8fb8);B(g,.3,.35,1.1,-1.1,.45,0,0xff8fb8);B(g,.3,.35,1.1,1.1,.45,0,0xff8fb8);B(g,2,.12,.9,0,.4,0,0xffc0da);
 if(l>=2){B(g,.7,1,.6,1.9,0,-.2,0xe8e8f0);B(g,.5,.15,.05,1.9,.6,.12,0xff5f6f)}if(l>=3){C(g,.5,.5,-2.1,0,.6,0xfff0f5);C(g,.04,1.5,-1.6,0,-.4,0x888899);Sp(g,.22,-1.6,1.6,-.4,E(0xfff0b0))}return g}
const MK={d:mkDesk,p:mkDeco,r:mkRest};
function refSlot(s){if(s.f)return;if(s.g){sc.remove(s.g);s.g=null}const l=items[s.k]||0;if(l){s.g=MK[s.t](l);s.g.position.set(s.x,0,s.z);sc.add(s.g)}s.mk.visible=!l&&!!owned[s.r]&&buildMode;updLamps()}
function moveRoom(i){const q=rooms[i];q.ox=-8+q.cx*8;q.oz=-6+q.cy*6;q.lk.position.set(q.ox+4,1.8,q.oz+3);q.hit.position.set(q.ox+4,1,q.oz+3)}
function loadCells(d){if(d&&d.cells)d.cells.forEach((a,i)=>{if(rooms[i]&&a){rooms[i].cx=a[0];rooms[i].cy=a[1];moveRoom(i)}})}
function refAll(){applyExt();rooms.forEach((r,i)=>{const tk=!!owned[i]||rooms.some((q,j)=>j!=i&&owned[j]&&q.cx==r.cx&&q.cy==r.cy),q4=RR(i);floors[i].visible=!!owned[i];r.lk.visible=!tk;r.hit.userData.ref.dead=tk;r.nm.visible=!!owned[i];r.nm.position.set((q4[0]+q4[1])/2,2.95,q4[2]+.5)});slots.forEach(refSlot);buildWalls()}

/* ===== karyawan ===== */
const pb=new T.Mesh(new T.OctahedronGeometry(.2),new T.MeshBasicMaterial({color:0x55ff66}));pb.scale.y=1.6;sc.add(pb);
function addEmp(n,o,k,en,isBoss,pos){const p=makeSim(o),g=p.g,lb=label(n,isBoss?'#1e9bd8':'#ff7eb6',1.7,.42,120);lb.position.y=2.45;g.add(lb);
 const hm=new T.Mesh(new T.SphereGeometry(.9),new T.MeshBasicMaterial({visible:false}));hm.position.y=1;g.add(hm);
 const e={n,o,...p,k,energy:en??100,st:'idle',nx:'idle',wp:[],rs:null,acc:0,boss:isBoss};hm.userData.ref={t:'e',e};hits.push(hm);g.position.set(...pos);sc.add(g);emps.push(e);return e}
const seat=k=>[slotBy[k].x,slotBy[k].z+1.2],roomAt=(x,z)=>{for(let i=0;i<rooms.length;i++){const q=RR(i);if(x>q[0]&&x<q[1]&&z>q[2]&&z<q[3])return i}return -1};
const nbs=a=>{const[c,r]=rc(a);return[[c-1,r],[c+1,r],[c,r-1],[c,r+1]].map(p=>ID(...p)).filter(i=>i>=0)};
function route(e,tx,tz){const P=[];let cur=roomAt(e.g.position.x,e.g.position.z),dst=roomAt(tx,tz);if(cur<0||!owned[cur]){P.push([-4,8.2],[-4,5.2]);cur=0}
 if(cur!=dst&&dst>=0){const pr={[cur]:-1},q=[cur];while(q.length){const a=q.shift();if(a==dst)break;nbs(a).forEach(b=>{if(owned[b]&&!(b in pr)){pr[b]=a;q.push(b)}})}
  const path=[];for(let b=dst;b!=null&&b!=-1&&b in pr;b=pr[b])path.unshift(b);
  for(let i=0;i+1<path.length;i++){const[ac,ar]=rc(path[i]),[bc,br]=rc(path[i+1]);if(ar==br){const s=bc>ac?1:-1,z=-3+ar*6,bx=-8+(s>0?ac+1:ac)*8;P.push([bx-.9*s,z],[bx+.9*s,z])}else{const s=br>ar?1:-1,x=-4+ac*8,bz=-6+(s>0?ar+1:ar)*6;P.push([x,bz-.9*s],[x,bz+.9*s])}}}
 P.push([tx,tz]);return P}
const go=(e,x,z,nx)=>{e.wp=route(e,x,z);e.nx=nx;e.st='walk'};
const freeDesk=r=>slots.find(q=>q.t=='d'&&items[q.k]&&owned[q.r]&&(r==null||q.r==r)&&!emps.some(e=>e.k==q.k)),freeRest=()=>slots.find(q=>q.t=='r'&&items[q.k]&&owned[q.r]&&!emps.some(o=>o.rs==q.k));
const rate=e=>{if(e.st!='work'||!e.k)return 0;const s=slotBy[e.k],l=items[e.k]||0;let b=1;slots.forEach(q=>{if(q.r==s.r&&q.t=='p')b+=.06*(items[q.k]||0)});return .6*l*rooms[s.r].m*b*(e.energy<25?.5:1)*(e.boss?1.5:1)*(boost>0?2:1)*(1+.25*((RL[s.r]||1)-1))*(e.boss?1:.7+.1*(e.sk||3))};
function updE(e,dt){const g=e.g;
 if(e.st=='walk'){const w=e.wp[0];if(!w){e.st=e.nx;return}const dx=w[0]-g.position.x,dz=w[1]-g.position.z,d=Math.hypot(dx,dz);if(d<.12){e.wp.shift();return}
  const s=Math.min(d,3.2*dt);g.rotation.y=Math.atan2(dx,dz);g.position.x+=dx/d*s;g.position.z+=dz/d*s;pose(e,'stand');g.position.y=Math.abs(Math.sin(clock*10))*.05;
  e.legs.forEach((l,i)=>l.h.rotation.x=Math.sin(clock*10+i*3.14)*.6);e.arms.forEach((a,i)=>a.rotation.x=Math.sin(clock*10+i*3.14+3.14)*.5);return}
 if(e.st=='work'){pose(e,'sit');g.rotation.y=Math.PI;e.energy=Math.max(0,e.energy-1.4*dt);e.arms.forEach((a,i)=>a.rotation.x=-1.1+Math.sin(clock*9+i*2)*.15);e.hd.rotation.x=Math.sin(clock*2+e.energy)*.05;
  if(e.energy<25){const r=freeRest();if(r){e.rs=r.k;go(e,r.x,r.z+.1,'rest')}}}
 else if(e.st=='rest'){pose(e,'sit');g.rotation.y=0;e.arms.forEach(a=>a.rotation.x=-.3);e.energy=Math.min(100,e.energy+9*(items[e.rs]||1)*dt);
  if(e.energy>=95){e.rs=null;if(e.k){const q=seat(e.k);go(e,q[0],q[1],'work')}else e.st='idle'}}
 else{pose(e,'stand');e.arms.forEach(a=>a.rotation.x=0)}}

/* ===== UI ===== */
let sel=null;
function toast(t){const e=$('toast');e.textContent=t;e.style.opacity=1;clearTimeout(toast.t);toast.t=setTimeout(()=>e.style.opacity=0,2000)}
function pop(x,y,z,t){const v=new T.Vector3(x,y,z).project(cam),d=document.createElement('div');d.className='pop';d.textContent=t;d.style.left=(v.x*.5+.5)*innerWidth+'px';d.style.top=(-v.y*.5+.5)*innerHeight+'px';document.body.appendChild(d);setTimeout(()=>d.remove(),1400)}
function closeSheet(){$('sheet').style.display='none';sel=null;document.body.classList.remove('pt')}
function sheet(t,s,bs){document.body.classList.remove('pt');const el=$('sheet');el.style.display='flex';el.innerHTML='<button id="x">'+ICO.x+'</button><b>'+t+'</b><p>'+s+'</p>';$('x').onclick=closeSheet;bs.forEach(([tx,fn,ok,icn,cls])=>{const b=document.createElement('button');if(icn){const a=document.createElement('span');a.className='ic';a.innerHTML=icn;b.appendChild(a)}const t=document.createElement('span');t.className='tx';t.textContent=tx;b.appendChild(t);if(cls)b.className=cls;b.disabled=ok===false;b.onclick=fn;el.appendChild(b)})}
function addXp(n){xp+=n;let need=lvl*150;while(xp>=need){xp-=need;lvl++;gems+=2;toast('⭐ Naik ke Level '+lvl+'! +2 💎');need=lvl*150}}
function spend(c){if(coins<c){toast('Koin kurang');return false}coins-=c;addXp(c/10);return true}
function buy(s,l){if(!spend(CAT[s.t][l-1][1]))return;items[s.k]=l;refSlot(s);closeSheet();toast('✨ '+CAT[s.t][l-1][0]+' terpasang!');save()}
function openSlot(s){const cat=CAT[s.t],l=items[s.k]||0;
 if(!l)return sheet('Slot kosong',s.t=='d'?'Pasang meja kerja agar karyawan bisa bekerja.':s.t=='p'?'Dekorasi menambah penghasilan ruangan.':'Tempat istirahat memulihkan energi.',[['Beli '+cat[0][0]+' $'+cat[0][1],()=>buy(s,1),coins>=cat[0][1]]]);
 const w=emps.find(e=>e.k==s.k),bs=[];if(l<cat.length)bs.push(['⬆ Upgrade: '+cat[l][0]+' $'+cat[l][1],()=>buy(s,l+1),coins>=cat[l][1]]);
 bs.push(['Jual +$'+Math.floor(cat[l-1][1]/2),()=>{if(w)return toast('Meja masih dipakai');coins+=Math.floor(cat[l-1][1]/2);items[s.k]=0;refSlot(s);closeSheet();save()}]);
 sheet(cat[l-1][0]+' · Lv'+l,s.t=='d'?'Penghasilan ×'+l+' · Pemakai: '+(w?w.n:'kosong'):s.t=='p'?'+6% penghasilan ruangan per level':'Pemulihan energi ×'+l,bs)}
function openEmp(e){sel=e;if(e.boss)setTimeout(()=>document.body.classList.add('pt'),0);sheet(e.n+(e.boss?' (Bos)':''),'Energi: <span id="ebar"></span>% · Penghasilan: $'+rate(e).toFixed(1)+'/dtk',[['☕ Traktir kopi $15',()=>{if(spend(15)){e.energy=Math.min(100,e.energy+40);toast('☕ Segar lagi!')}},coins>=15],...(e.boss?[]:[['🚫 Pecat karyawan',()=>askFire(e)]])])}
function buyRoom(i){const q=rooms[i];if(owned[i])return;if(lvl<q.lv)return toast('Butuh Level '+q.lv);if(coins<q.p)return toast('Koin kurang');PL.start(i)}
function openRooms(){sheet('🏢 Toko Ruangan','Buka ruangan baru, lalu taruh di sebelah ruangan lain — bebas pilih tempatnya.',rooms.map((q,i)=>i?[(owned[i]?'✓ '+q.n:(lvl<q.lv?'🔒 ':'')+q.n+' · Lv'+q.lv+' · $'+q.p),()=>buyRoom(i),!owned[i]&&lvl>=q.lv&&coins>=q.p]:null).filter(Boolean))}
function hire(){const n=emps.length-1,c=100+60*n;if(!freeDesk())return toast('Butuh meja kosong! Beli meja dulu.');if(!spend(c))return;
 const e=addEmp(rnd(NM),randO(),null,100,false,[-4,0,13]);e.k=freeDesk().k;const q=seat(e.k);go(e,q[0],q[1],'work');toast('👋 Karyawan baru masuk!');save()}
const Q=[['Tekan 💼 agar Bos bekerja',()=>flags.worked,100,0],['Beli meja kedua (🪑 → Meja → Meja Kerja)',()=>slots.filter(s=>s.t=='d'&&items[s.k]).length>=2,150,0],['Rekrut karyawan pertama (🛒)',()=>emps.length>=2,200,1],['Kumpulkan total $800',()=>earned>=800,200,1],['Upgrade meja ke Lv2',()=>slots.some(s=>s.t=='d'&&(items[s.k]||0)>=2),250,1],['Buka Employee Lounge (🏢)',()=>owned[1],300,2]];
function openQ(){sheet('📋 Misi','Selesaikan misi untuk hadiah!',Q.map((q,i)=>{const ok=q[1](),cl=claimed[i];return[(cl?'✅ ':ok?'🎁 Klaim: ':'⬜ ')+q[0]+' ($'+q[2]+(q[3]?' +'+q[3]+'💎':'')+')',()=>{coins+=q[2];gems+=q[3];claimed[i]=1;addXp(50);openQ();save()},ok&&!cl]}))}
function openShop(){const n=emps.length-1;sheet('🛒 Toko','Rekrut tim dan tukar permata.',[['👤 Rekrut karyawan $'+(100+60*n),hire,coins>=100+60*n],['💎 Tukar $800 → 1 💎',()=>{if(coins>=800){coins-=800;gems++;openShop()}},coins>=800]])}
function openList(){sheet('👥 Karyawan',emps.map(e=>e.n+(e.boss?' (Bos)':'')+' — energi '+Math.round(e.energy)+'% · $'+rate(e).toFixed(1)+'/dtk').join('<br>'),[])}
function openMenu(){sheet('<span class="dots">•••</span><span>Menu</span>','Hari ini: $'+Math.floor(earned)+' dihasilkan total',[['Kamera dari atas',()=>{pol=.03;az=0;upd();closeSheet()},true,ICO.cam],['Tes cahaya: '+(lightTest==null?'jam asli HP':lightTest+':00'),()=>{const o=[null,6,12,18,22];lightTest=o[(o.indexOf(lightTest)+1)%o.length];applyLight();closeSheet()},true,ICO.sun],['Tes: undang pelamar sekarang',()=>{genApps();closeSheet()},true,ICO.users],['Tes: tambah koin +$1000',()=>{coins+=1000;$('cn').textContent=Math.floor(coins);try{save()}catch(e){};toast('Koin +$1000');closeSheet()},true,ICO.cam],['Tes: tambah koin +$10000',()=>{coins+=10000;$('cn').textContent=Math.floor(coins);try{save()}catch(e){};toast('Koin +$10000');closeSheet()},true,ICO.cam],['Mulai ulang (hapus progres)',()=>{localStorage.removeItem('sims2');localStorage.removeItem('tp_mat');location.reload()},true,ICO.rst,'dg']])}
$('cplus').onclick=()=>openQ();$('gplus').onclick=()=>PN.open('apps');
$('tbB').onclick=()=>{buildMode=!buildMode;slots.forEach(refSlot);toast(buildMode?'Mode Bangun: tap ＋ untuk memasang':'Mode Bangun mati')};
$('tbR').onclick=()=>PN.open('rooms');$('tbE').onclick=()=>PN.open('team');$('tbS').onclick=()=>PN.open('apps');$('tbM').onclick=openMenu;$('clip').onclick=openQ;$('bank').onclick=()=>sheet('🏛 Laporan','Level '+lvl+' · Karyawan '+(emps.length-1)+' · Total pendapatan $'+Math.floor(earned),[]);
$('aw').onclick=()=>{if(boss.st=='work'){boss.k=null;go(boss,-1,3,'idle');return toast('Bos berhenti bekerja')}const s=freeDesk();if(!s)return toast('Butuh meja kosong');boss.k=s.k;const q=seat(s.k);go(boss,q[0],q[1],'work');flags.worked=1};
$('ar').onclick=()=>{const r=freeRest();if(!r)return toast('Belum ada tempat istirahat! Beli kasur/sofa di 🪑');boss.rs=r.k;go(boss,r.x,r.z+.1,'rest')};
$('ac').onclick=()=>{if(cool>0)return toast('Tunggu '+Math.ceil(cool)+' dtk');cool=20;emps.forEach(e=>e.energy=Math.min(100,e.energy+15));toast('💬 Semangat! Energi +15')};
$('ab').onclick=()=>{if(gems<1)return toast('Butuh 1 💎');gems--;boost=15;toast('✨ Penghasilan ×2 selama 15 dtk!')};
$('rl').onclick=()=>{az-=.5;upd()};$('rr').onclick=()=>{az+=.5;upd()};$('top').onclick=()=>{pol=pol<.2?.75:.03;upd()};
const ray=new T.Raycaster(),mv=new T.Vector2();
function pick(x,y){if(PL.on())return PL.tap(x,y);if(FD.busy())return;mv.set(x/innerWidth*2-1,-y/innerHeight*2+1);ray.setFromCamera(mv,cam);
 const h=ray.intersectObjects(hits).find(i=>{const r=i.object.userData.ref;return r&&!r.dead&&!(r.t=='s'&&(!owned[r.s.r]||(!buildMode&&!items[r.s.k])))});if(!h)return closeSheet();
 const r=h.object.userData.ref;if(r.t=='s')openSlot(r.s);else if(r.t=='e')openEmp(r.e);else if(r.t=='f')FD.menu(r.f);else sheet('🏢 '+rooms[r.i].n,'Perluas kantor! Penghasilan ruangan ×'+rooms[r.i].m,[['Beli · Lv'+rooms[r.i].lv+' · $'+rooms[r.i].p,()=>buyRoom(r.i),lvl>=rooms[r.i].lv&&coins>=rooms[r.i].p]])}

/* ===== simpan & mulai ===== */
function save(){if(mode!='game')return;try{localStorage.setItem('sims2',JSON.stringify({ls:(typeof LSDATA!=='undefined'?LSDATA:[]),cw:(typeof CWDATA!=='undefined'?CWDATA:[]),me,coins,gems,xp,lvl,earned,clock,owned,items,claimed,flags,free:FD.dump(),inv:FD.inv,ext:EXT,cells:rooms.map(r=>[r.cx,r.cy]),mig:1,ver:2,rl:RL,apps,nextApp,appId,emps:emps.filter(e=>!e.boss).map(e=>[e.n,e.o,e.k,e.energy,e.sk||3])}))}catch(e){}}
function startGame(d){mode='game';document.body.classList.remove('cr');pv.background=null;rebuild();loadCells(d);loadExt(d);try{CWm.load(d)}catch(e){}try{LSm.load(d)}catch(e){}migrateStart(d);refAll();FD.load(d);
 boss=addEmp(me.fn,meO(),null,100,true,[-1,0,10.5]);
 if(d)d.emps.forEach(a=>{const e=addEmp(a[0],a[1],a[2],a[3],false,[-4,0,13]);e.sk=a[4]||3;if(e.k){const q=seat(e.k);go(e,q[0],q[1],'work')}});
 else{FD.starter();genApps(1);toast('Selamat datang, '+me.fn+'! Tekan 💼 untuk mulai bekerja');save()}fit();tickApps();updBadge()}
$('ok').onclick=()=>{if(!me.fn.trim())me.fn='Alex';startGame(null)};
let saved=null;try{saved=JSON.parse(localStorage.getItem('sims2'))}catch(e){}

/* ===== TOKO PERABOT BEBAS (tambahan) ===== */
const EXT=rooms.map(()=>({w:0,e:0,n:0,s:0})),RR=i=>{const q=rooms[i],x=EXT[i];return[q.ox-x.w,q.ox+8+x.e,q.oz-x.n,q.oz+6+x.s]};
function loadExt(d){if(d&&d.ext)d.ext.forEach((e,i)=>Object.assign(EXT[i],e))}
function applyExt(){rooms.forEach((q,i)=>{const[x0,x1,z0,z1]=RR(i),W=x1-x0,D=z1-z0,f=floors[i];f.geometry.dispose();f.geometry=new T.PlaneGeometry(W,D);f.position.set((x0+x1)/2,.03,(z0+z1)/2);const m=f.material.map;m.repeat.set(W/2,D/2);m.needsUpdate=true})}
const FCAT=[['mvs','Pindah & Jual','💱'],['rooms','Perluas Ruangan','↔️'],['inv','Inventaris','📦'],...rooms.map(q=>[q.id,q.n,q.e])];
const BK=[0xd04a4a,0x4a7ad0,0xe0b040,0x4aa860];
/* ---- builder perabot ruangan baru ---- */
const mkWC=(a,b)=>g=>{B(g,.45,.4,.55,0,0,.1,a);C(g,.27,.06,0,.4,.1,b,.27);B(g,.52,.55,.18,0,.3,-.3,a);B(g,.1,.04,.1,.15,.85,-.3,0xb0b8c4)};
const mkBed=(w,d,bl)=>g=>{B(g,w,.35,d,0,0,0,0x8a5a34);B(g,w-.1,.2,d-.1,0,.35,0,0xffffff);B(g,w*.6,.22,d-.1,w*.18,.4,0,bl);B(g,.5,.14,d*.5,-w/2+.4,.55,0,0xffe0ee);B(g,.15,.9,d,-w/2-.05,0,0,0x6a4326)};
const mkTV=g=>{B(g,1.8,.5,.5,0,0,0,0x2b2b3a);B(g,1.7,1,.06,0,.55,0,0x111118);B(g,1.6,.9,.02,0,.6,.04,E(0x6fc8ff))};
const ALLR=['work','lounge','studio','meeting','research','recept','toilet','it','pantry','bed','trader'];
const WKR=['work','research','studio','it'];

const JLC={};
function jlTex(k){if(JLC[k])return JLC[k];
const c=document.createElement('canvas');c.width=c.height=128;const g=c.getContext('2d');
const R=(n)=>Math.floor(Math.random()*n);
if(k==='jl1'){g.fillStyle='#9a9a9e';g.fillRect(0,0,128,128);g.strokeStyle='#6f6f74';g.lineWidth=3;
