const FD=(()=>{
 const list=[],inv={},gnd=new T.Plane(new T.Vector3(0,1,0),0),rc2=new T.Raycaster(),v2=new T.Vector2(),pt=new T.Vector3();
 let ed=null,drag=false;
 const st=document.createElement('style');st.textContent=`#fring{position:fixed;width:0;height:0;z-index:20;display:none}#fring .rb{position:absolute;width:46px;height:46px}#fring .ok{background:#52b81f;left:-23px;top:-96px}#fring .no{background:#e53935;left:-88px;top:-44px}#fring .ro{left:42px;top:-44px}#fring .mv{left:-23px;top:10px;touch-action:none}#fring .se{background:#f39c12;left:42px;top:-96px}#fring .ok.dis{filter:grayscale(1);opacity:.6}
#ftag{position:absolute;top:-148px;left:0;transform:translateX(-50%);background:#fff;color:#0c4a73;font-weight:800;font-size:14px;padding:4px 14px;border-radius:14px;white-space:nowrap}
#shop{position:fixed;right:10px;top:calc(env(safe-area-inset-top,0px) + 48px);bottom:56px;width:min(52vw,430px);background:#5db3f5;border:4px solid #fff;border-radius:18px;z-index:15;display:none;flex-direction:column;overflow:hidden;box-shadow:0 6px 20px #0006}
#shh{background:#1c7fb8;color:#fff;text-align:center;font-weight:800;padding:10px 54px;text-transform:uppercase;position:relative}#shh button{position:absolute;left:6px;top:50%;transform:translateY(-50%);width:38px;height:38px;border-radius:50%;background:#52b81f;border:3px solid #fff;color:#fff;font-size:18px;padding:0}
#shg{display:grid;grid-template-columns:repeat(auto-fill,minmax(86px,1fr));gap:8px;padding:10px;overflow-y:auto}
.fcd{background:#1a8fcf;border:3px solid #fff;border-radius:12px;padding:6px 3px;text-align:center;color:#fff;font-size:12px;font-weight:700;cursor:pointer}.fcd i{display:block;font-style:normal;font-size:32px;line-height:1.3;background:#fff3;border-radius:8px;margin-bottom:3px}.fcd u{display:block;text-decoration:none;color:#ffe36b}.fcd.or{background:#f5a623}.fcd.lk{opacity:.55;filter:grayscale(.6)}`;document.head.appendChild(st);
 const ring=document.createElement('div');ring.id='fring';ring.innerHTML='<div id="ftag"></div><button class="rb ok" data-a="ok">✓</button><button class="rb no" data-a="no">✕</button><button class="rb ro" data-a="ro">↻</button><button class="rb mv" data-a="mv">✥</button><button class="rb se" data-a="se">💰</button>';document.body.appendChild(ring);
 const shop=document.createElement('div');shop.id='shop';shop.innerHTML='<div id="shh"><button id="shb"></button><span id="sht"></span><button id="shx">'+ICO.x+'</button></div><div id="shg"></div>';document.body.appendChild(shop);
 const dim=(f)=>f.r%2?[FC[f.k][4],FC[f.k][3]]:[FC[f.k][3],FC[f.k][4]];
 function BR(){const a=[];
  rooms.forEach((q,n)=>{const r=RR(n);a.push([r[1]-1,r[1]+1,q.oz+2,q.oz+4],[r[0]-1,r[0]+1,q.oz+2,q.oz+4],[q.ox+3,q.ox+5,r[2]-1,r[2]+1],[q.ox+3,q.ox+5,r[3]-1,r[3]+1])});return a}
 function jlValid(f){return !list.some(o=>{if(o===f)return false;const[w2,d2]=dim(o);return f.x<o.x+w2&&f.x+1>o.x&&f.z<o.z+d2&&f.z+1>o.z})}
 function valid(f){if(FC[f.k][0]==='jalan')return jlValid(f);const[w,d]=dim(f),br=BR();
  for(let i=0;i<w;i++)for(let j=0;j<d;j++){const cx=f.x+i,cz=f.z+j;
   if(!rooms.some((q,n)=>{const r=RR(n);return owned[n]&&FC[f.k][9].includes(q.id)&&cx+.5>r[0]&&cx+.5<r[1]&&cz+.5>r[2]&&cz+.5<r[3]}))return false;
   if(br.some(b=>cx<b[1]&&cx+1>b[0]&&cz<b[3]&&cz+1>b[2]))return false}
  return !list.some(o=>{if(o===f)return false;const[w2,d2]=dim(o);return f.x<o.x+w2&&f.x+w>o.x&&f.z<o.z+d2&&f.z+d>o.z})}
 function mesh(f){const g=new T.Group();FC[f.k][7](g);f.g=g;sc.add(g);
  const h=new T.Mesh(new T.BoxGeometry(1,1.6,1),new T.MeshBasicMaterial({visible:false}));h.userData.ref={t:'f',f};f.h=h;sc.add(h);hits.push(h);pos(f)}
 function pos(f){const[w,d]=dim(f),cx=f.x+w/2,cz=f.z+d/2;f.g.position.set(cx,0,cz);f.g.rotation.y=f.r*Math.PI/2;f.h.position.set(cx,.8,cz);f.h.scale.set(w,1,d)}
 function drop(f){sc.remove(f.g);sc.remove(f.h);const i=hits.indexOf(f.h);if(i>=0)hits.splice(i,1)}
let uidn=0;
 function link(f){const p=FC[f.k];if(!p[8])return;const[w,d]=dim(f),cx=f.x+w/2,cz=f.z+d/2-(p[8][0]=='d'?.4:0);let s=f.key&&slotBy[f.key];
  if(!s){if(!f.key)f.key='f'+(++uidn);else if(/^f\d+$/.test(f.key))uidn=Math.max(uidn,+f.key.slice(1));s={k:f.key,r:0,t:p[8][0],x:0,z:0,g:null,f:true,mk:{visible:false,children:[]}};slots.push(s);slotBy[s.k]=s}
  s.x=cx;s.z=cz;s.r=Math.max(0,roomAt(cx,cz));s.g=f.g;items[s.k]=items[s.k]||p[8][1];f.s=s;
  emps.forEach(e=>{if(e.k==s.k&&s.t=='d'){const q=seat(s.k);go(e,q[0],q[1],'work')}if(e.rs==s.k&&s.t=='r')go(e,s.x,s.z+.1,'rest')});updLamps()}
 function unlink(f){const s=f.s;if(!s)return;slots.splice(slots.indexOf(s),1);delete slotBy[s.k];items[s.k]=0;f.s=null;f.key=null;updLamps()}
 const inUse=f=>{const s=f.s;return !!s&&emps.some(e=>e.k==s.k||e.rs==s.k)};
 function migrate(d){if(!d||d.mig||!d.items)return;const W=[[2.4,1.8,'d'],[5.6,1.8,'d'],[2.4,4.1,'d'],[5.6,4.1,'d'],[7.3,.7,'p'],[.7,5.3,'p']],Rs=[[2.2,1.6,'r'],[5.8,1.6,'r'],[4,4.2,'r'],[7.3,.7,'p'],[.7,5.3,'p']];d.free=d.free||[];
  rooms.forEach((q,i)=>(q.k=='w'?W:Rs).forEach((o,j)=>{const key=i+'-'+j;if(!(d.items[key]>0))return;const t=o[2],sx=q.ox+o[0],sz=q.oz+o[1];
   d.free.push(t=='d'?['w1',Math.round(sx-1.5),Math.round(sz-.6),0,key]:t=='r'?['r1',Math.round(sx-2),Math.round(sz-1),0,key]:['t1',Math.round(sx-.5),Math.round(sz-.5),0,key])}));d.mig=1}
 let pad=null;
 function refresh(){if(!ed)return;const f=ed.f,ok=valid(f),[w,d]=dim(f);pos(f);pad.scale.set(w,d,1);pad.position.set(f.x+w/2,.08,f.z+d/2);pad.material.color.set(ok?0x44ff44:0xff4444);ring.querySelector('.ok').classList.toggle('dis',!ok)}
 function spot(k,pr){const f={k,x:0,z:0,r:0},ord=rooms.map((q,n)=>n).sort((a,b)=>(rooms[b].id==pr)-(rooms[a].id==pr));for(const n of ord){const q=rooms[n];if(!owned[n])continue;for(let z=q.oz;z<q.oz+6;z++)for(let x=q.ox;x<q.ox+8;x++){f.x=x;f.z=z;if(valid(f))return f}}return null}
 function begin(f,isNew,fi){ed={f,isNew,fi,bak:{x:f.x,z:f.z,r:f.r}};pad=new T.Mesh(new T.PlaneGeometry(1,1),new T.MeshBasicMaterial({color:0x44ff44,transparent:true,opacity:.5,depthWrite:false}));pad.rotation.x=-Math.PI/2;sc.add(pad);
  ring.style.display='block';ring.querySelector('.se').style.display=isNew?'none':'block';ring.querySelector('.ro').style.display=FC[f.k][8]&&FC[f.k][8][0]!='p'?'none':'block';
  const p=FC[f.k];$('ftag').textContent=isNew?p[1]+(fi?' · Gratis':' · $'+p[5]):p[1];refresh();loop()}
 function end(){ed=null;drag=false;sc.remove(pad);ring.style.display='none'}
 function loop(){if(!ed)return;const[w,d]=dim(ed.f);const v=new T.Vector3(ed.f.x+w/2,.9,ed.f.z+d/2).project(cam);ring.style.left=(v.x*.5+.5)*innerWidth+'px';ring.style.top=(-v.y*.5+.5)*innerHeight+'px';requestAnimationFrame(loop)}
 function ground(x,y){v2.set(x/innerWidth*2-1,-y/innerHeight*2+1);rc2.setFromCamera(v2,cam);return rc2.ray.intersectPlane(gnd,pt)}
 function dragTo(x,y){if(!ed||!ground(x,y))return;const[w,d]=dim(ed.f);ed.f.x=Math.round(pt.x-w/2);ed.f.z=Math.round(pt.z-d/2);refresh()}
 const cv2=R.domElement;
 cv2.addEventListener('pointerdown',e=>{if(!ed||!ground(e.clientX,e.clientY))return;const f=ed.f,[w,d]=dim(f);if(pt.x>f.x-.6&&pt.x<f.x+w+.6&&pt.z>f.z-.6&&pt.z<f.z+d+.6){drag=true;e.stopImmediatePropagation()}});
 cv2.addEventListener('pointermove',e=>{if(drag)e.stopImmediatePropagation()});
 addEventListener('pointermove',e=>{if(drag)dragTo(e.clientX,e.clientY)});
 addEventListener('pointerup',()=>{drag=false});
 ring.addEventListener('pointerdown',e=>{if(e.target.dataset.a=='mv'){drag=true;e.preventDefault()}});
 ring.addEventListener('click',e=>{const a=e.target.dataset.a;if(!a||!ed)return;const f=ed.f,p=FC[f.k];
  if(a=='ro'){const[w,d]=dim(f),cx=f.x+w/2,cz=f.z+d/2;f.r=(f.r+1)%4;const[w2,d2]=dim(f);f.x=Math.round(cx-w2/2);f.z=Math.round(cz-d2/2);refresh()}
  if(a=='ok'){if(!valid(f))return toast('Tidak muat di sini!');if(ed.isNew&&!ed.fi&&!spend(p[5]))return;if(ed.fi)inv[f.k]--;list.push(f);link(f);end();toast('✨ '+p[1]+' terpasang!');save()}
  if(a=='no'){if(ed.isNew)drop(f);else{Object.assign(f,ed.bak);pos(f);list.push(f)}end()}
  if(a=='se'){if(inUse(f))return toast('Masih dipakai karyawan');const v=Math.floor(p[5]/2);coins+=v;unlink(f);drop(f);end();toast('Terjual +$'+v);save()}});
 /* ===== TOKOPLUS: dinding & lantai + kategori Home Store ===== */
const TPW=[["White Simple Tile",10,"#e8e8e8"],["Red Paint",11,"#8a3b36"],["Green Paint",11,"#4a6b45"],["Eggshell Paint",11,"#e0d3b8"],["White Paint",11,"#e6e6e2"],["Brown Paint",11,"#6b4636"],["Purple Paint",11,"#6a4f86"],["Pink Wall",11,"#d97fc0"],["Creme Paint",11,"#d9c9a3"],["Blue Paint",11,"#4a6078"],["Offwhite Paint",11,"#b9b8ae"],["Unpainted Wall",5,"#e9dfc9"]];
TPW.push(["Stone Tile Wall",15,"img:TEXTURES/stone_tile_wall_diff_2k.jpg"]);
const TPF=[["Plain Pine Floorboards",15,"#d9b27c"],["Rustic Plank",10,"#4a3a33"],["Blue Terrazzo",10,"#9aa0a0"],["Red Shag",10,"#5a0a0e"],["Blue Checkered Lino",15,"#a8cdd6"],["White Terrazzo",10,"#b8aea0"],["Yellow Shag",10,"#c99a0a"],["Sky Blue Carpet",5,"#4f8fc0"],["Old Brown Carpet",15,"#a79a7e"],["Red Terrazzo",10,"#5c2a20"],["Blue Shag",10,"#8a9aa8"],["Purple Carpet",5,"#5a2a70"]];
TPF.push(["Japanese Cedar Planks",25,"img:LANTAI/textures/japanese_cedar_planks_diff_2k.jpg"],["Lacquered Cherry Wood",30,"img:LANTAI/textures/lacquered_cherry_wood_diff_4k.jpg"],["Oak Veneer",25,"img:LANTAI/textures/oak_veneer_05_diff_2k.jpg"],["Plank Flooring",25,"img:LANTAI/textures/plank_flooring_04_diff_2k.jpg"]);
TPF.push(["Concrete Tile",25,"img:TEXTURES/concrete_tile_facade_diff_2k.jpg"]);
const TPOPEN=[["bedroom","Bedroom","🛏️"],["living","Living Room","🛋️"],["rugs","Rugs","🟫"],["outdoor","Outdoor Furniture","⛱️"],["bathroom","Bathroom","🚽"],["kitchen","Kitchen","🍳"],["dining","Dining Room","🍽️"],["lighting","Lighting","💡"],["electronics","Electronics","📺"],["counter","Counter Tops","🗄️"],["decor","Decorations","🗿"],["plants","Plants & Gardens","🌳"],["roofing","Roofing","🏚️"],["windows","Windows","🪟"],["outdoor_decor","Outdoor Decorations","🦩"],["doors","Doors","🚪"],["ext_walls","Exterior Walls","🧱"],["fireplaces","Fireplaces","🔥"],["chimneys","Chimneys","🏭"]];
const TPLOCK=[["support_posts","Support Posts"],["railings","Railings"],["balcony_paving","Balcony Paving"],["patio_paving","Patio Paving"],["patio_gates","Patio Gates"],["stairs","Stairs"],["pets","Pets"],["toddler","Toddler"],["preteen","Preteen"],["teen","Teen"],["pool_items","Pool Items"],["pool_interior","Pool Interior"],["pool_paving","Pool Paving"],["roof_items","Roof Items"]];
const TPS={stage:'mat',mat:null,room:-1,old:null,cost:0,isW:false,inited:false};
function tpxShade(h,d){const n=parseInt(h.slice(1),16),c=v=>Math.max(0,Math.min(255,v));return '#'+((1<<24)+(c((n>>16)+d)<<16)+(c(((n>>8)&255)+d)<<8)+c((n&255)+d)).toString(16).slice(1)}
function tpxLoad(){try{return JSON.parse(localStorage.getItem('tp_mat')||'{}')}catch(e){return {}}}
function tpxSave(i){try{const M=tpxLoad(),r=rooms[i];M[r.id]={t:r.t,wc:r.wc};localStorage.setItem('tp_mat',JSON.stringify(M))}catch(e){}}
function tpxSetFloor(i){const f=floors[i];if(!f)return;f.material.map=tex(...rooms[i].t);f.material.needsUpdate=true;applyExt()}
function tpxRevert(){if(TPS.room<0)return;const i=TPS.room,r=rooms[i];if(TPS.isW){r.wc=TPS.old;buildWalls()}else{r.t=TPS.old;tpxSetFloor(i)}TPS.room=-1;$('tpbar').style.display='none'}
function tpxPreview(i,cost,isW){tpxRevert();shut();TPS.room=i;TPS.cost=cost;TPS.isW=isW;const r=rooms[i];
 if(isW){TPS.old=r.wc;r.wc=parseInt(TPS.mat.v.slice(1),16);buildWalls()}
 else{TPS.old=r.t.slice();r.t=[TPS.mat.v,TPS.mat.v.indexOf('img:')==0?TPS.mat.v:tpxShade(TPS.mat.v,-14)];tpxSetFloor(i)}
 $('tpbar').style.display='flex';$('tpcost').textContent='$'+cost}
function tpxOk(){if(TPS.room<0)return;if(coins<TPS.cost){toast('Koin kurang');tpxRevert();return}
 coins-=TPS.cost;tpxSave(TPS.room);TPS.room=-1;$('tpbar').style.display='none';$('cn').textContent=Math.floor(coins);try{save()}catch(e){}toast('Berhasil diganti!')}
function tpxInit(){if(TPS.inited)return;TPS.inited=true;
 FCAT.push(['h_walls','Walls','🧱']);FCAT.push(['h_floors','Floors','🟦']);
 TPOPEN.forEach(c=>FCAT.push(['h_'+c[0],c[1],c[2]]));
 TPLOCK.forEach(c=>FCAT.push(['h_'+c[0],c[1],'🔒']));
 const b=document.createElement('div');b.id='tpbar';
 b.style.cssText='position:fixed;left:50%;bottom:90px;transform:translateX(-50%);display:none;align-items:center;gap:12px;z-index:99;background:#000b;padding:8px 14px;border-radius:30px;color:#fff;font-weight:bold';
 b.innerHTML='<button id="tpno" style="width:46px;height:46px;border-radius:50%;border:0;background:#e53935;color:#fff;font-size:22px">✕</button><span id="tpcost"></span><button id="tpok" style="width:46px;height:46px;border-radius:50%;border:0;background:#2e9e3a;color:#fff;font-size:22px">✓</button>';
 document.body.appendChild(b);$('tpno').onclick=tpxRevert;$('tpok').onclick=tpxOk;
 new MutationObserver(()=>{[...$('shg').children].forEach(d=>{if(d.textContent.indexOf('🔒')>=0&&!d.classList.contains('lk'))d.classList.add('lk')})}).observe($('shg'),{childList:true})}
function tpxDraw(){
 if(view=='cat'){TPS.stage='mat';return false}
 if(view!='it'||!cat)return false;
 const id=cat[0];
 if(TPLOCK.some(c=>'h_'+c[0]==id)){view='cat';draw();toast('Terkunci 🔒');return true}
 if(id!='h_walls'&&id!='h_floors')return false;
 const isW=id=='h_walls',g=$('shg');g.innerHTML='';$('shb').innerHTML=ICO.back;$('sht').textContent=cat[1];
 if(TPS.stage=='mat'){
  (isW?TPW:TPF).forEach(m=>{const d=document.createElement('div');d.className='fcd';
   d.innerHTML='<i style="display:block;width:46px;height:34px;margin:0 auto 4px;border:1px solid #000;border-radius:4px;background:'+(m[2].indexOf('img:')==0?'url('+m[2].slice(4)+') center/cover':m[2])+'"></i>'+m[0]+'<u class="v">$'+m[1]+'</u>';
   d.onclick=()=>{TPS.mat={n:m[0],p:m[1],v:m[2]};TPS.stage='room';draw();toast('Pilih ruangan untuk '+m[0])};g.appendChild(d)});
 }else{
  rooms.forEach((r,i)=>{if(!owned[i])return;const [x0,x1,z0,z1]=RR(i),W=x1-x0,D=z1-z0,n=isW?Math.ceil((W+D)/2):Math.ceil(W*D/4),cost=TPS.mat.p*n;
   const d=document.createElement('div');d.className='fcd';
   d.innerHTML='<i>'+(isW?'🧱':'🟦')+'</i>'+r.n+'<u class="v">$'+cost+'</u>';
   d.onclick=()=>tpxPreview(i,cost,isW);g.appendChild(d)});
 }
 return true}
setTimeout(()=>{try{const M=tpxLoad();rooms.forEach((r,i)=>{const s=M[r.id];if(!s)return;if(s.t&&floors[i]){r.t=s.t;floors[i].material.map=tex(...s.t);floors[i].material.needsUpdate=true}if(s.wc!=null)r.wc=s.wc});applyExt();buildWalls()}catch(e){console.log('tp load',e)}},1500);
/* ===== END TOKOPLUS ===== */
let view='cat',cat=null;
 function draw(){tpxInit();if(tpxDraw())return;const g=$('shg');g.innerHTML='';$('shb').innerHTML=view=='cat'?ICO.cart:ICO.back;$('shx').onclick=()=>shut();
  if(view=='cat'){$('sht').textContent='Toko Perabot';FCAT.forEach(c=>{const d=document.createElement('div'),ri=rooms.findIndex(q=>q.id==c[0]),lk=ri>=0&&!owned[ri];d.className='fcd'+(c[0]=='mvs'||c[0]=='rooms'?' or':'')+(lk?' lk':'');d.innerHTML='<i>'+c[2]+'</i>'+c[1]+(ri>=0?'<u class="'+(lk?'y':'v')+'">'+(lk?'Beli ruangan':'Lv'+RL[ri])+'</u>':'');
   d.onclick=()=>{if(c[0]=='mvs'){shut();return toast('Tap perabot di kantor untuk pindah, simpan, atau jual')}if(c[0]=='rooms'){shut();return RM.start()}if(c[0]=='cw'){shut();return CWm.start()}if(c[0]=='ls'){shut();return LSm.start()}cat=c;view='it';draw()};g.appendChild(d)})}
  else{$('sht').textContent=cat[1];const ri=rooms.findIndex(q=>q.id==cat[0]);
   Object.keys(FC).filter(k=>cat[0]=='inv'?(inv[k]||0)>0:FC[k][9].includes(cat[0])&&(FC[k][0]!="lampu"||cat[0]=="lampu")).forEach(k=>{const p=FC[k];let lk='';if(cat[0]!='inv'){if(ri>=0&&!owned[ri])lk='🔒 Beli ruangan dulu';else if(ri>=0&&RL[ri]<p[10])lk='🔒 Upgrade ruangan ke Lv'+p[10];else if(lvl<p[6])lk='🔒 Level '+p[6]}
    const d=document.createElement('div');d.className='fcd'+(lk?' lk':'');d.innerHTML='<i>'+p[2]+'</i>'+p[1]+'<u'+(lk?' class="y"':'')+'>'+(cat[0]=='inv'?'x'+inv[k]:lk?lk.replace('🔒 ',''):'$'+p[5])+'</u>';
    d.onclick=()=>{if(lk)return toast(lk.replace('🔒 ',''));if(cat[0]!='inv'&&coins<p[5])return toast('Koin kurang');const f=spot(k,cat[0]=='inv'?null:cat[0]);if(!f)return toast('Tidak ada ruang kosong untuk perabot ini');shut();mesh(f);begin(f,true,cat[0]=='inv')};g.appendChild(d)});
   if(!g.children.length)g.innerHTML='<p style="color:#fff;grid-column:1/-1;text-align:center;font-weight:700">'+(cat[0]=='inv'?'Inventaris kosong':'Belum ada perabot')+'</p>'}}
 function shut(){shop.style.display='none';hl(null)}
 $('shb').onclick=()=>{if(view=='it'){view='cat';draw()}else shut()};
 $('tbB').onclick=()=>{if(ed)return;if(shop.style.display=='flex')return shut();closeSheet();PN.close();view='cat';draw();shop.style.display='flex';hl('tbB')};
 return{inv,busy:()=>!!ed,menu:f=>{if(ed)return;const p=FC[f.k],v=Math.floor(p[5]/2),rm=()=>{if(inUse(f)){toast('Masih dipakai karyawan');return false}list.splice(list.indexOf(f),1);unlink(f);drop(f);closeSheet();return true};sheet(p[1],'Pindahkan, simpan ke inventaris, atau jual.',[['✥ Pindahkan',()=>FD.edit(f)],['📦 Simpan ke Inventaris',()=>{if(!rm())return;inv[f.k]=(inv[f.k]||0)+1;toast('Disimpan ke inventaris');save()}],['💰 Jual +$'+v,()=>{if(!rm())return;coins+=v;toast('Terjual +$'+v);save()}]])},edit:f=>{if(ed)return;list.splice(list.indexOf(f),1);closeSheet();begin(f,false)},
  dump:()=>list.map(f=>[f.k,f.x,f.z,f.r,f.key||null]),starter:()=>{const f={k:'w1',x:-7,z:1,r:0};mesh(f);list.push(f);link(f)},load:d=>{migrate(d);if(d&&d.inv)Object.assign(inv,d.inv);if(d&&d.free)d.free.forEach(a=>{if(!FC[a[0]])return;const f={k:a[0],x:a[1],z:a[2],r:a[3],key:a[4]||null};mesh(f);list.push(f);link(f)})}}
})();

const RM=(()=>{
 const MAX=3,COST=25;let on=false,dx0=[0,0],moved=false,base=null,bars=[],drag=null,cam0=null;
 const st=document.createElement('style');st.textContent=`#rmui{display:none}body.rm #rmui{display:block}body.rm #tabs,body.rm #acts,body.rm #port,body.rm #lc,body.rm #shop{display:none!important}
#rmb{position:fixed;left:50%;bottom:14px;transform:translateX(-50%);background:#0a6fa6;color:#fff;border:3px solid #fff;border-radius:18px;padding:12px 20px;font-weight:700;font-size:15px;max-width:84vw;text-align:center;z-index:21}
#rmc{position:fixed;left:50%;bottom:84px;transform:translateX(-50%);display:none;align-items:center;gap:10px;z-index:21}#rmp{background:#fff;color:#555;font-weight:800;padding:10px 18px;border-radius:16px}#rmx{position:fixed;right:10px;top:calc(env(safe-area-inset-top,0px) + 8px);background:#52b81f;z-index:21}`;document.head.appendChild(st);
 const ui=document.createElement('div');ui.id='rmui';ui.innerHTML='<div id="rmb">Tarik dinding bertanda putih untuk memperbesar ruangan.</div><div id="rmc"><button class="rb" id="rmn" style="background:#e53935">✕</button><span id="rmp"></span><button class="rb" id="rmy" style="background:#52b81f">✓</button></div><button class="rb" id="rmx">↩</button>';document.body.appendChild(ui);
 const gp=new T.Plane(new T.Vector3(0,1,0),0),rcr=new T.Raycaster(),v3=new T.Vector2(),pt=new T.Vector3();
 const ground=(x,y)=>{v3.set(x/innerWidth*2-1,-y/innerHeight*2+1);rcr.setFromCamera(v3,cam);return rcr.ray.intersectPlane(gp,pt)};
 const area=e=>(8+e.w+e.e)*(6+e.n+e.s),clone=()=>JSON.parse(JSON.stringify(EXT));
 const cost=()=>Math.round(EXT.reduce((s,e,i)=>s+(area(e)-area(base[i])),0)*COST);
 function place(){bars.forEach(b=>{const q=RR(b.i),h=b.sd=='n'||b.sd=='s',fx=b.sd=='n'?q[2]:b.sd=='s'?q[3]:b.sd=='w'?q[0]:q[1],a=h?q[0]:q[2],z=h?q[1]:q[3];
  b.r=h?[a,z,fx,fx]:[fx,fx,a,z];b.m.scale.set(h?z-a:.7,1,h?.7:z-a);b.m.position.set(h?(a+z)/2:fx,2.7,h?fx:(a+z)/2);b.h.scale.set(h?z-a:2.6,1,h?2.6:z-a);b.h.position.set(h?(a+z)/2:fx,1.5,h?fx:(a+z)/2)});
  const c=cost();$('rmc').style.display=c>0?'flex':'none';$('rmp').textContent='$'+c}
 function mk(){bars.forEach(b=>{sc.remove(b.m);sc.remove(b.h)});bars=[];for(let i=0;i<rooms.length;i++){if(!owned[i])continue;const[c,r]=rc(i);
  ['n','s','w','e'].filter(sd=>ID(c+(sd=='w'?-1:sd=='e'?1:0),r+(sd=='n'?-1:sd=='s'?1:0))<0).forEach(sd=>{const m=new T.Mesh(new T.BoxGeometry(1,.25,1),new T.MeshBasicMaterial({color:0xffffff,transparent:true,opacity:.8,depthTest:false}));m.renderOrder=9;sc.add(m);const h=new T.Mesh(new T.BoxGeometry(1,3,1),new T.MeshBasicMaterial({visible:false}));sc.add(h);bars.push({i,sd,m,h,r:null})})}place()}
 function redo(){applyExt();buildWalls();place()}
 function setExt(b,p){const q=rooms[b.i],e=EXT[b.i],k=b.sd;let v=k=='w'?q.ox-p.x:k=='e'?p.x-(q.ox+8):k=='n'?q.oz-p.z:p.z-(q.oz+6);v=Math.max(base[b.i][k],Math.min(MAX,Math.round(v)));if(e[k]!=v){e[k]=v;redo()}}
 function stop(){if(cost()>0){EXT.forEach((e,i)=>Object.assign(e,base[i]));redo()}on=false;drag=null;bars.forEach(b=>{sc.remove(b.m);sc.remove(b.h)});bars=[];document.body.classList.remove('rm');if(cam0){pol=cam0.pol;az=cam0.az;rad=cam0.rad;tg.copy(cam0.tg);upd()}}
 $('rmx').onclick=stop;
 $('rmn').onclick=()=>{EXT.forEach((e,i)=>Object.assign(e,base[i]));redo()};
 $('rmy').onclick=()=>{const c=cost();if(c>0&&!spend(c))return;base=clone();place();toast('🏠 Ruangan diperbesar!');save()};
 const cv3=R.domElement;
 cv3.addEventListener('pointerdown',e=>{if(!on)return;v3.set(e.clientX/innerWidth*2-1,-e.clientY/innerHeight*2+1);rcr.setFromCamera(v3,cam);const ix=rcr.intersectObjects(bars.map(b=>b.h))[0],best=ix&&bars.find(b=>b.h===ix.object);if(best){drag=best;dx0=[e.clientX,e.clientY];moved=false;e.stopImmediatePropagation()}});
 cv3.addEventListener('pointermove',e=>{if(drag)e.stopImmediatePropagation()});
 addEventListener('pointermove',e=>{if(!drag)return;if(Math.hypot(e.clientX-dx0[0],e.clientY-dx0[1])>12)moved=true;if(moved&&ground(e.clientX,e.clientY))setExt(drag,pt)});
 addEventListener('pointerup',()=>{if(drag&&!moved){const e=EXT[drag.i],k=drag.sd;if(e[k]>=MAX)toast('Sudah maksimal');else{e[k]++;redo()}}drag=null});
 return{start(){if(on)return;closeSheet();on=true;base=clone();cam0={pol,az,rad,tg:tg.clone()};document.body.classList.add('rm');pol=.03;az=0;rad=36;tg.set(0,0,0);upd();mk()}}
})();

var CWDATA=[];
FCAT.splice(2,0,['cw','Dinding','🧱']);
const CWm=(()=>{
const cv3=R.domElement,rcr=new T.Raycaster(),v3=new T.Vector2(),gp=new T.Plane(new T.Vector3(0,1,0),0),pt=new T.Vector3();
const grp=new T.Group();sc.add(grp);
const hl=new T.Mesh(new T.BoxGeometry(1,1,1),new T.MeshBasicMaterial({color:0xffe14d,wireframe:true,depthTest:false}));hl.renderOrder=10;hl.visible=false;grp.add(hl);
let on=false,pan=false,type='brick',col='#c9b79c',list=[],sel=null,act=null,st=[0,0],moved=false,BT=null;
const sn=v=>Math.round(v*2)/2;
function brickTex(){if(BT)return BT;const c=document.createElement('canvas');c.width=c.height=64;const x=c.getContext('2d');x.fillStyle='#b5523b';x.fillRect(0,0,64,64);x.fillStyle='#d9c7b0';for(let r=0;r<4;r++){x.fillRect(0,r*16,64,2);const o=r%2?0:16;for(let k=0;k<2;k++)x.fillRect(o+k*32,r*16,2,16)}BT=new T.CanvasTexture(c);BT.wrapS=BT.wrapT=T.RepeatWrapping;return BT}
function rep(o){const m=o.m.material.map;if(m)m.repeat.set(Math.max(1,o.d.l/1.2),Math.max(1,o.d.h/1.2))}
function mk(d){
if(d.t==='glass')return new T.MeshLambertMaterial({color:0x9fdcff,transparent:true,opacity:.35,depthWrite:false});
if(d.t==='brick'){const t=brickTex().clone();t.needsUpdate=true;return new T.MeshLambertMaterial({map:t})}
return new T.MeshLambertMaterial({color:d.c})}
function remat(o){const old=o.m.material;if(old.map)old.map.dispose();old.dispose();o.m.material=mk(o.d);rep(o);o.m.castShadow=o.d.t!=='glass'}
function hf(){if(!sel){hl.visible=false;return}const d=sel.d;hl.visible=true;hl.scale.set(d.l+.12,d.h+.12,.3);hl.position.set(d.x,d.h/2,d.z);hl.rotation.y=d.a}
function fit(o){const d=o.d,m=o.m;m.scale.set(d.l,d.h,.14);m.position.set(d.x,d.h/2,d.z);m.rotation.y=d.a;rep(o);if(o===sel)hf()}
function build(d){const m=new T.Mesh(new T.BoxGeometry(1,1,1),new T.MeshLambertMaterial());m.receiveShadow=true;grp.add(m);const o={d,m};remat(o);fit(o);return o}
function sv(){CWDATA=list.map(o=>o.d);try{save()}catch(e){}}
const css=document.createElement('style');
css.textContent='#cwp{display:none;position:fixed;left:50%;bottom:6px;transform:translateX(-50%);z-index:22;background:#0a2a5ae6;border:2px solid #4fc3ff;border-radius:14px;padding:6px 8px;gap:5px;flex-wrap:wrap;justify-content:center;max-width:96vw;font:700 13px sans-serif;color:#fff}body.cw #cwp{display:flex}#cwp button{background:#1565c0;color:#fff;border:2px solid #7cc4ff;border-radius:9px;padding:6px 9px;font:700 13px sans-serif}#cwp button.on{background:#ffb300;color:#000}#cwp input{width:34px;height:30px;border:0;padding:0;background:none}body.cw #tabs,body.cw #acts,body.cw #port,body.cw #lc,body.cw #shop{display:none!important}';
document.head.appendChild(css);
const p=document.createElement('div');p.id='cwp';
p.innerHTML='<button data-t="glass">🪟 Kaca</button><button data-t="brick">🧱 Bata</button><button data-t="color">🎨 Warna</button><input id="cwc" type="color" value="#c9b79c"><button data-a="rl">↺</button><button data-a="rr">↻</button><button data-a="hm">Tinggi −</button><button data-a="hp">Tinggi +</button><button data-a="lm">Panjang −</button><button data-a="lp">Panjang +</button><button data-a="del">🗑</button><button id="cwpan" data-a="pan">✋ Kamera</button><button data-a="done">✔ Selesai</button>';
document.body.appendChild(p);
function ui(){p.querySelectorAll('[data-t]').forEach(b=>b.classList.toggle('on',b.dataset.t===(sel?sel.d.t:type)));$('cwc').value=sel&&sel.d.t==='color'?sel.d.c:col;$('cwpan').classList.toggle('on',pan)}
function select(o){sel=o;hf();ui()}
p.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;
if(b.dataset.t){type=b.dataset.t;if(sel){sel.d.t=type;remat(sel);sv()}ui();return}
const a=b.dataset.a,d=sel&&sel.d;
if(a==='pan'){pan=!pan;ui();return}
if(a==='done')return stop();
if(!d){toast('Ketuk dinding dulu');return}
if(a==='rl')d.a+=Math.PI/12;
else if(a==='rr')d.a-=Math.PI/12;
else if(a==='hp')d.h=Math.min(4,d.h+.3);
else if(a==='hm')d.h=Math.max(.6,d.h-.3);
else if(a==='lp')d.l=Math.min(24,d.l+.5);
else if(a==='lm')d.l=Math.max(.5,d.l-.5);
else if(a==='del'){grp.remove(sel.m);sel.m.geometry.dispose();list.splice(list.indexOf(sel),1);select(null);sv();return}
if(a==='hp'||a==='hm'||a==='lp'||a==='lm')remat(sel);
fit(sel);sv()});
$('cwc').addEventListener('input',e=>{col=e.target.value;type='color';if(sel){sel.d.c=col;sel.d.t='color';remat(sel)}ui()});
$('cwc').addEventListener('change',()=>{if(sel)sv()});
function gnd(e){v3.set(e.clientX/innerWidth*2-1,-e.clientY/innerHeight*2+1);rcr.setFromCamera(v3,cam);return rcr.ray.intersectPlane(gp,pt)}
cv3.addEventListener('pointerdown',e=>{if(!on||pan||!e.isPrimary)return;e.stopImmediatePropagation();st=[e.clientX,e.clientY];moved=false;act=null;
const hit=rcr.intersectObjects(list.map(o=>o.m))[0];
v3.set(e.clientX/innerWidth*2-1,-e.clientY/innerHeight*2+1);rcr.setFromCamera(v3,cam);
const h2=rcr.intersectObjects(list.map(o=>o.m))[0],o=h2&&list.find(q=>q.m===h2.object);
const g=gnd(e);
if(o&&o===sel&&g)act={k:'mv',o,ox:o.d.x-pt.x,oz:o.d.z-pt.z};
else{if(o)select(o);if(g)act={k:'new',x:sn(pt.x),z:sn(pt.z),o0:o}}
},true);
addEventListener('pointermove',e=>{if(!act)return;if(Math.hypot(e.clientX-st[0],e.clientY-st[1])>10)moved=true;if(!moved||!gnd(e))return;
if(act.k==='mv'){const d=act.o.d;d.x=sn(pt.x+act.ox);d.z=sn(pt.z+act.oz);fit(act.o)}
else{const x=sn(pt.x),z=sn(pt.z),dx=x-act.x,dz=z-act.z,l=Math.hypot(dx,dz);if(l<.5)return;
if(!act.o){act.o=build({x:act.x,z:act.z,a:0,l:1,h:2.4,t:type,c:col});list.push(act.o);select(act.o)}
const d=act.o.d;d.x=(x+act.x)/2;d.z=(z+act.z)/2;d.l=l;d.a=Math.atan2(-dz,dx);remat(act.o);fit(act.o)}});
const up=()=>{if(!act)return;const a=act;act=null;if(a.k==='new'){if(a.o)sv();else if(!a.o0&&!moved)select(null)}else if(moved)sv()};
addEventListener('pointerup',up);addEventListener('pointercancel',up);
function load(d){list.forEach(o=>grp.remove(o.m));list=[];select(null);((d&&d.cw)||[]).forEach(w=>{list.push(build({x:+w.x||0,z:+w.z||0,a:+w.a||0,l:Math.max(.5,+w.l||1),h:Math.max(.6,+w.h||2.4),t:w.t||'color',c:w.c||'#c9b79c'}))});CWDATA=list.map(o=>o.d)}
function start(){if(on)return;try{closeSheet()}catch(e){}on=true;pan=false;document.body.classList.add('cw');ui();toast('Seret di lantai untuk membuat dinding')}
function stop(){on=false;act=null;select(null);document.body.classList.remove('cw')}
return{start,stop,load}})();

var LSDATA=[];
FCAT.splice(3,0,['ls','LED Strip','✨']);
const LSm=(()=>{
const cv3=R.domElement,rcr=new T.Raycaster(),v3=new T.Vector2(),gp=new T.Plane(new T.Vector3(0,1,0),0),pt=new T.Vector3();
const grp=new T.Group();sc.add(grp);
let on=false,pan=false,col='#00e5ff',blink=false,list=[],sel=null,act=null,st=[0,0],moved=false;
const sn=v=>Math.round(v*2)/2;
function fit(o){const d=o.d,k=o===sel?.14:.07;o.g.position.set(d.x,d.y,d.z);o.g.rotation.y=d.a;o.bar.scale.set(d.l,k,k);o.hit.scale.set(d.l,.6,.6)}
function paint(o){o.m.color.set(o.d.c);o.L.col.set(o.d.c)}
function build(d){const g=new T.Group();grp.add(g);const m=new T.MeshBasicMaterial({color:d.c});const bar=new T.Mesh(new T.BoxGeometry(1,1,1),m);g.add(bar);const hit=new T.Mesh(new T.BoxGeometry(1,1,1),new T.MeshBasicMaterial({visible:false}));g.add(hit);const o={d,g,bar,hit,m,L:null};o.L=ltMk(g,'strip',{l:new T.Color(d.c).getHex(),i:1.6,d:7,h:.3});o.L.mats.push(m);fit(o);return o}
function sv(){LSDATA=list.map(o=>o.d);try{save()}catch(e){}}
const css=document.createElement('style');
css.textContent='#lsp{display:none;position:fixed;left:50%;bottom:6px;transform:translateX(-50%);z-index:22;background:#0a2a5ae6;border:2px solid #4fc3ff;border-radius:14px;padding:6px 8px;gap:5px;flex-wrap:wrap;justify-content:center;max-width:96vw;font:700 13px sans-serif;color:#fff}body.ls #lsp{display:flex}#lsp button{background:#1565c0;color:#fff;border:2px solid #7cc4ff;border-radius:9px;padding:6px 9px;font:700 13px sans-serif}#lsp button.on{background:#ffb300;color:#000}#lsp button[data-c]{width:30px;height:30px;padding:0}#lsp input{width:34px;height:30px;border:0;padding:0;background:none}body.ls #tabs,body.ls #acts,body.ls #port,body.ls #lc,body.ls #shop{display:none!important}';
document.head.appendChild(css);
const p=document.createElement('div');p.id='lsp';
const PC=['#00e5ff','#8a4dff','#ff2a2a','#2aff4a','#ffe02a','#ff3fa8','#ffffff','#2a5aff'];
p.innerHTML=PC.map(c=>'<button data-c="'+c+'" style="background:'+c+'"></button>').join('')+'<input id="lsc" type="color" value="#00e5ff"><button id="lsbl" data-a="bl">Kedip</button><button data-a="rl">↺</button><button data-a="rr">↻</button><button data-a="lm">Panjang −</button><button data-a="lp">Panjang +</button><button data-a="ym">Tinggi −</button><button data-a="yp">Tinggi +</button><button data-a="del">🗑</button><button id="lspan" data-a="pan">✋ Kamera</button><button data-a="done">✔ Selesai</button>';
document.body.appendChild(p);
function ui(){$('lsbl').classList.toggle('on',!!(sel?sel.d.b:blink));$('lspan').classList.toggle('on',pan);$('lsc').value=sel?sel.d.c:col}
function select(o){sel=o;list.forEach(fit);ui()}
p.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;
if(b.dataset.c){col=b.dataset.c;if(sel){sel.d.c=col;paint(sel);sv()}ui();return}
const a=b.dataset.a,d=sel&&sel.d;
if(a==='pan'){pan=!pan;ui();return}
if(a==='done')return stop();
if(a==='bl'){if(sel){d.b=d.b?0:1;sv()}else blink=!blink;ui();return}
if(!d){toast('Ketuk LED dulu');return}
if(a==='rl')d.a+=Math.PI/12;
else if(a==='rr')d.a-=Math.PI/12;
else if(a==='yp')d.y=Math.min(3.5,d.y+.25);
else if(a==='ym')d.y=Math.max(.05,d.y-.25);
else if(a==='lp')d.l=Math.min(24,d.l+.5);
else if(a==='lm')d.l=Math.max(.5,d.l-.5);
else if(a==='del'){grp.remove(sel.g);list.splice(list.indexOf(sel),1);select(null);sv();return}
fit(sel);sv()});
$('lsc').addEventListener('input',e=>{col=e.target.value;if(sel){sel.d.c=col;paint(sel)}});
$('lsc').addEventListener('change',()=>{if(sel)sv()});
function ray(e){v3.set(e.clientX/innerWidth*2-1,-e.clientY/innerHeight*2+1);rcr.setFromCamera(v3,cam)}
function gnd(e){ray(e);return rcr.ray.intersectPlane(gp,pt)}
cv3.addEventListener('pointerdown',e=>{if(!on||pan||!e.isPrimary)return;e.stopImmediatePropagation();st=[e.clientX,e.clientY];moved=false;act=null;ray(e);
const h=rcr.intersectObjects(list.map(o=>o.hit))[0],o=h&&list.find(q=>q.hit===h.object);
const g=gnd(e);
if(o){select(o);if(g)act={k:'mv',o,ox:o.d.x-pt.x,oz:o.d.z-pt.z}}
else if(g)act={k:'new',x:sn(pt.x),z:sn(pt.z),o:null}},true);
addEventListener('pointermove',e=>{if(!act)return;if(Math.hypot(e.clientX-st[0],e.clientY-st[1])>10)moved=true;if(!moved||!gnd(e))return;
if(act.k==='mv'){const d=act.o.d;d.x=sn(pt.x+act.ox);d.z=sn(pt.z+act.oz);fit(act.o)}
else{const x=sn(pt.x),z=sn(pt.z),dx=x-act.x,dz=z-act.z,l=Math.hypot(dx,dz);if(l<.5)return;
if(!act.o){act.o=build({x:act.x,y:.08,z:act.z,a:0,l:1,c:col,b:blink?1:0});list.push(act.o);select(act.o)}
const d=act.o.d;d.x=(x+act.x)/2;d.z=(z+act.z)/2;d.l=l;d.a=Math.atan2(-dz,dx);fit(act.o)}});
const up=()=>{if(!act)return;const a=act;act=null;if(a.k==='new'){if(a.o)sv();else if(!moved)select(null)}else if(moved)sv()};
addEventListener('pointerup',up);addEventListener('pointercancel',up);
function tick(ts){requestAnimationFrame(tick);const t=ts/1000;list.forEach(o=>{try{o.L.col.set(o.d.b&&Math.floor(t*2)%2?'#000000':o.d.c)}catch(e){}})}
requestAnimationFrame(tick);
function load(d){list.forEach(o=>grp.remove(o.g));list=[];sel=null;((d&&d.ls)||[]).forEach(w=>{list.push(build({x:+w.x||0,y:+w.y||.08,z:+w.z||0,a:+w.a||0,l:Math.max(.5,+w.l||1),c:w.c||'#00e5ff',b:w.b?1:0}))});LSDATA=list.map(o=>o.d)}
function start(){if(on)return;try{closeSheet()}catch(e){}on=true;pan=false;document.body.classList.add('ls');ui();toast('Seret di lantai untuk menarik LED')}
function stop(){on=false;act=null;select(null);document.body.classList.remove('ls')}
return{start,stop,load}})();

/* ===== PILIH LOKASI RUANGAN BARU ===== */
const PL=(()=>{
 let on=false,idx=-1,marks=[],cam0=null;
 const st=document.createElement('style');st.textContent=`#plui{display:none}body.pl #plui{display:block}body.pl #tabs,body.pl #acts,body.pl #port,body.pl #lc,body.pl #shop{display:none!important}#plb{position:fixed;left:50%;bottom:14px;transform:translateX(-50%);background:#0a6fa6;color:#fff;border:3px solid #fff;border-radius:18px;padding:10px 18px;font-weight:700;font-size:14px;max-width:84vw;text-align:center;z-index:21}#plx{position:fixed;right:10px;top:calc(env(safe-area-inset-top,0px) + 8px);background:#e53935;z-index:21}`;document.head.appendChild(st);
 const ui=document.createElement('div');ui.id='plui';ui.innerHTML='<div id="plb"></div><button class="rb" id="plx">✕</button>';document.body.appendChild(ui);
 const ry=new T.Raycaster(),v=new T.Vector2();
 const free=(c,r)=>{const a=[-8+c*8,c*8,-6+r*6,r*6];return !rooms.some((q,i)=>{if(!owned[i])return false;const x=RR(i);return a[0]<x[1]-.01&&a[1]>x[0]+.01&&a[2]<x[3]-.01&&a[3]>x[2]+.01})};
 const adj=(c,r)=>[[c-1,r],[c+1,r],[c,r-1],[c,r+1]].some(p=>ID(...p)>=0);
 function clear(){marks.forEach(m=>{sc.remove(m);m.geometry.dispose();m.material.dispose()});marks=[]}
 function stop(){on=false;clear();document.body.classList.remove('pl');if(cam0){pol=cam0.pol;az=cam0.az;rad=cam0.rad;tg.copy(cam0.tg);upd();cam0=null}}
 function place(c,r){const q=rooms[idx];if(!spend(q.p))return stop();q.cx=c;q.cy=r;moveRoom(idx);Object.assign(EXT[idx],{w:0,e:0,n:0,s:0});owned[idx]=1;const n=q.n;stop();refAll();toast('🏢 '+n+' terbuka!');save()}
 $('plx').onclick=stop;
 return{on:()=>on,
  start(i){if(on)return;closeSheet();const cs=[];for(let c=-2;c<=3;c++)for(let r=-2;r<=1;r++)if(free(c,r)&&adj(c,r))cs.push([c,r]);
   if(!cs.length)return toast('Tidak ada tempat kosong di sebelah ruangan lain');
   on=true;idx=i;cam0={pol,az,rad,tg:tg.clone()};document.body.classList.add('pl');
   cs.forEach(([c,r])=>{const m=new T.Mesh(new T.PlaneGeometry(7.4,5.4),new T.MeshBasicMaterial({color:0x55ff77,transparent:true,opacity:.5,depthWrite:false}));m.rotation.x=-Math.PI/2;m.position.set(-4+c*8,.09,-3+r*6);m.userData.cell=[c,r];sc.add(m);marks.push(m)});
   $('plb').textContent='Ketuk kotak hijau untuk menaruh '+rooms[i].n+' ($'+rooms[i].p+')';pol=.03;az=0;rad=44;tg.set(0,0,-4);upd()},
  tap(x,y){v.set(x/innerWidth*2-1,-y/innerHeight*2+1);ry.setFromCamera(v,cam);const h=ry.intersectObjects(marks)[0];if(h)place(...h.object.userData.cell)},
  auto(i){let best=null,bd=1e9;for(let c=-3;c<=4;c++)for(let r=-2;r<=2;r++)if(free(c,r)&&adj(c,r)){const dd=Math.abs(c)+Math.abs(r-1);if(dd<bd){bd=dd;best=[c,r]}}if(!best)return false;const q=rooms[i];q.cx=best[0];q.cy=best[1];moveRoom(i);Object.assign(EXT[i],{w:0,e:0,n:0,s:0});owned[i]=1;return true}}
})();

/* ===== FITUR BARU: toko ruangan (upgrade), pelamar 15 menit, rekrut & pecat ===== */
const APPGAP=()=>(3+Math.random()*4)*60*1000,ROLE=['Analis','Peneliti','Editor','Trader','Admin','Developer','Desainer'];
const upCost=i=>Math.round(Math.max(rooms[i].p,300)*RL[i]*.8),upNeed=i=>rooms[i].lv+RL[i];
function upRoom(i){if(RL[i]>=3)return;if(lvl<upNeed(i))return toast('Butuh Level '+upNeed(i));if(!spend(upCost(i)))return;RL[i]++;toast('⬆ '+rooms[i].n+' Lv'+RL[i]+'! Furniture baru terbuka');save();PN.refresh()}
function migrateStart(d){if(!d||(d.ver||0)>=2)return;rooms.forEach((q,i)=>{if(q.s&&!(d.owned&&d.owned[i])){owned[i]=0;PL.auto(i)}})}
function perf(){let t=0;emps.forEach(e=>t+=rate(e));return t}
function updBadge(){const b=$('bd');if(!b)return;b.textContent=apps.length;b.style.display=apps.length?'grid':'none'}
function genApps(quiet){const n=Math.min(6,2+Math.floor(perf()/4));let c=0;
 for(let i=0;i<n&&apps.length<10;i++,c++)apps.push({id:appId++,n:rnd(NM),o:randO(),sk:1+Math.floor(Math.random()*Math.min(5,2+lvl/2)),role:rnd(ROLE)});
 updBadge();if(!quiet&&c)toast('📩 '+c+' pelamar baru! Cek 🛒');PN.refresh();save()}
function tickApps(){const now=Date.now();if(!nextApp)nextApp=now+APPGAP();let c=0;while(now>=nextApp&&c<4){genApps();nextApp+=APPGAP();c++}if(now>=nextApp)nextApp=now+APPGAP()}
function hireApp(id,ri){const a=apps.find(x=>x.id==id);if(!a)return;const d=freeDesk(ri);if(!d)return toast('Tidak ada meja kosong di ruangan itu');const c=80+50*a.sk;if(!spend(c))return;
 apps=apps.filter(x=>x!==a);const e=addEmp(a.n,a.o,null,100,false,[-4,0,13]);e.sk=a.sk;e.role=a.role;e.k=d.k;const q=seat(e.k);go(e,q[0],q[1],'work');updBadge();toast('👋 '+a.n+' direkrut ke '+rooms[ri].n);save();PN.refresh()}
function fire(e){const i=emps.indexOf(e);if(i<0||e.boss)return;emps.splice(i,1);sc.remove(e.g);for(let j=hits.length-1;j>=0;j--)if(hits[j].userData.ref&&hits[j].userData.ref.e===e)hits.splice(j,1);if(sel===e)closeSheet();toast(e.n+' dipecat');save();PN.refresh()}
function askFire(e){sheet('Pecat '+e.n+'?','Karyawan akan keluar dari kantor dan mejanya kosong lagi.',[['Ya, pecat',()=>{fire(e);closeSheet()}],['Batal',closeSheet]])}
const PN=(()=>{
 const el=document.createElement('div');el.id='pn';el.innerHTML='<div id="pnh"><span id="hi">'+ICO.cart+'</span><span id="pnt">Toko</span><button id="pnx">'+ICO.x+'</button></div><div id="pnt2"></div><div id="pnb"></div>';document.body.appendChild(el);
 let tab='rooms',cf=null;
 const star=n=>starS(n);
 const av=o=>`<svg viewBox="0 0 40 48" width="46" height="54" style="flex:none">${o.hs==1||o.hs==3?`<rect x="7" y="16" width="5" height="22" rx="2.5" fill="${hx(o.hc)}"/><rect x="28" y="16" width="5" height="22" rx="2.5" fill="${hx(o.hc)}"/>`:''}<rect x="6" y="30" width="28" height="20" rx="9" fill="${hx(o.shirt)}"/><rect x="17" y="24" width="6" height="8" fill="${hx(o.skin)}"/><circle cx="20" cy="18" r="11" fill="${hx(o.skin)}"/><path d="M8.5 18a11.5 11.5 0 0 1 23 0c-4-3-8-5-11.5-5S12.5 15 8.5 18z" fill="${hx(o.hc)}"/><circle cx="16" cy="19" r="1.4" fill="#222"/><circle cx="24" cy="19" r="1.4" fill="#222"/><path d="M16.5 24q3.5 2.5 7 0" stroke="#a5455a" stroke-width="1.3" fill="none"/></svg>`;
 function svg(i){const q=rooms[i],own=owned[i],rl=RL[i],a=q.t[0],b=q.t[1],em=(q.ic||[]).slice(0,own?Math.min(3,rl+1):2),ps=[[55,66],[34,62],[76,62]];
  return `<svg viewBox="0 0 110 100" width="104" height="94" style="${own?'':'filter:grayscale(.85);opacity:.8'}"><polygon points="13,62 55,38 55,12 13,36" fill="#f6ecdc"/><polygon points="55,38 97,62 97,36 55,12" fill="#e4d6bf"/><polygon points="22,50.9 38,41.7 38,27.7 22,36.9" fill="#bfe3ff"/><polygon points="72,41.7 88,50.9 88,36.9 72,27.7" fill="#bfe3ff"/><polyline points="13,36 55,12 97,36" fill="none" stroke="#7a5238" stroke-width="2"/><polygon points="55,38 97,62 55,86 13,62" fill="${a}"/><polygon points="55,38 76,50 55,62 34,50" fill="${b}"/><polygon points="55,62 76,74 55,86 34,74" fill="${b}"/><polygon points="13,62 55,86 55,92 13,68" fill="#6b4a30"/><polygon points="55,86 97,62 97,68 55,92" fill="#8a6040"/>${em.map((t,k)=>`<text x="${ps[k][0]}" y="${ps[k][1]}" font-size="17" text-anchor="middle">${t}</text>`).join('')}${own?'':'<text x="55" y="66" font-size="24" text-anchor="middle">🔒</text>'}</svg>`}
 function roomCard(i){const q=rooms[i],own=owned[i],rl=RL[i];let h=`<div class="rcd${own?'':' lk'}">${svg(i)}<div class="rin"><b>${q.e} ${q.n}</b>`;
  if(own){const nx=Object.values(FC).filter(p=>p[9].includes(q.id)&&p[10]==rl+1).map(p=>p[1]);
   h+=`<small>Level ${rl}/3 ${star(rl)}${q.k=='w'?' &nbsp; Pendapatan ×'+(q.m*(1+.25*(rl-1))).toFixed(2):''}</small><small>${rl<3?(nx.length?'Terbuka di Lv'+(rl+1)+': '+nx.slice(0,3).join(', '):'Upgrade menambah bonus ruangan'):'Semua furniture terbuka'}</small>`;
   if(rl<3){const ok=lvl>=upNeed(i)&&coins>=upCost(i);h+=`<button class="pb b" data-a="up" data-i="${i}" ${ok?'':'disabled'}>${ICO.up} Lv${rl+1} · $${upCost(i)}${lvl<upNeed(i)?' · butuh Lv'+upNeed(i):''}</button>`}
   h+=`<button class="pb g" data-a="exp" data-i="${i}">${ICO.exp} Perluas</button>`}
  else h+=`<small>${q.ds}</small><small>Butuh Level ${q.lv} · Pendapatan ×${q.m}</small><button class="pb" data-a="buy" data-i="${i}" ${lvl>=q.lv&&coins>=q.p?'':'disabled'}>🔓 Beli $${q.p}${lvl<q.lv?' · butuh Lv'+q.lv:' · pilih lokasi'}</button>`;
  return h+'</div></div>'}
 function roomsTab(){const idx=rooms.map((q,i)=>i),o=idx.filter(i=>owned[i]),l=idx.filter(i=>!owned[i]).sort((a,b)=>rooms[a].lv-rooms[b].lv);
  return [...o,...l].map(roomCard).join('')}
 function appsTab(){const fr=rooms.map((q,i)=>[i,slots.filter(s=>s.t=='d'&&items[s.k]&&owned[s.r]&&s.r==i&&!emps.some(e=>e.k==s.k)).length]).filter(x=>x[1]>0);
  let h=`<small style="color:#4a7a99">Pelamar baru datang acak tiap 3-7 menit. Makin bagus pendapatan kantor, makin banyak yang melamar. Berikutnya sekitar ${Math.max(0,Math.ceil((nextApp-Date.now())/60000))} mnt.</small>`;
  if(!apps.length)h+='<div class="rcd"><div class="rin">Belum ada pelamar saat ini.</div></div>';
  apps.forEach(a=>{const c=80+50*a.sk;h+=`<div class="rcd">${av(a.o)}<div class="rin"><b>${a.n}</b><small>${a.role} · ${star(a.sk)} · Biaya $${c}</small>${fr.length?`<select id="sl${a.id}">${fr.map(([i,n])=>`<option value="${i}">${rooms[i].n} (${n} meja kosong)</option>`).join('')}</select>`:'<small>⚠ Belum ada meja kosong. Beli meja di 🪑 dulu.</small>'}<button class="pb" data-a="hire" data-i="${a.id}" ${fr.length&&coins>=c?'':'disabled'}>✅ Rekrut</button><button class="pb g" data-a="rej" data-i="${a.id}">Tolak</button></div></div>`});
  return h+`<button class="pb b" data-a="gem" ${coins>=800?'':'disabled'}>💎 Tukar $800 → 1 💎</button>`}
 function teamTab(){const t=emps.map((e,i)=>[e,i]).filter(x=>!x[0].boss);if(!t.length)return '<div class="rcd"><div class="rin">Belum ada karyawan. Rekrut dari tab Pelamar.</div></div>';
  return t.map(([e,i])=>`<div class="rcd">${av(e.o)}<div class="rin"><b>${e.n}</b><small>${e.role||'Staf'} · ${star(e.sk||3)} · ${e.k&&slotBy[e.k]?rooms[slotBy[e.k].r].n:'-'}</small><small>Energi ${Math.round(e.energy)}% · $${rate(e).toFixed(1)}/dtk</small>${cf===i?`<small><b>Yakin pecat ${e.n}?</b></small><button class="pb r" data-a="fy" data-i="${i}">Ya, pecat</button><button class="pb g" data-a="fn" data-i="0">Batal</button>`:`<button class="pb r" data-a="fire" data-i="${i}">🚫 Pecat</button>`}</div></div>`).join('')}
 function act(a,i){
  if(a=='buy'){PN.close();return buyRoom(i)}
  if(a=='up')return upRoom(i);
  if(a=='exp'){PN.close();return RM.start()}
  if(a=='hire'){const s=$('sl'+i);return hireApp(i,s?+s.value:0)}
  if(a=='rej'){apps=apps.filter(x=>x.id!=i);updBadge();save();return render()}
  if(a=='gem'){if(coins>=800){coins-=800;gems++;toast('💎 +1');save();render()}return}
  if(a=='fire'){cf=i;return render()}
  if(a=='fn'){cf=null;return render()}
  if(a=='fy'){const e=emps[i];cf=null;if(e)fire(e);render()}}
 function render(){$('pnt').textContent=tab=='rooms'?'Toko Ruangan':tab=='apps'?'Pelamar Kerja':'Tim Kantor';
  const T=[['rooms',ICO.bld+' Ruangan'],['apps',ICO.user+' Pelamar'+(apps.length?' ('+apps.length+')':''),apps.length],['team',ICO.users+' Tim ('+(emps.length-1)+')']],tb=$('pnt2');tb.innerHTML='';
  T.forEach(([k,n,rd])=>{const b=document.createElement('button');b.innerHTML=n+(rd?'<span class="rd"></span>':'');b.className=tab==k?'on':'';b.onclick=()=>{tab=k;cf=null;render()};tb.appendChild(b)});
  const bd=$('pnb');bd.innerHTML=tab=='rooms'?roomsTab():tab=='apps'?appsTab():teamTab();
  bd.querySelectorAll('[data-a]').forEach(b=>b.onclick=()=>act(b.dataset.a,+b.dataset.i))}
 $('pnx').onclick=()=>PN.close();
 return{open(t){tab=t||tab;cf=null;const s=$('shop');if(s)s.style.display='none';closeSheet();el.style.display='flex';hl(tab=='rooms'?'tbR':tab=='team'?'tbE':'tbS');render()},close(){el.style.display='none';hl(null)},refresh(){if(el.style.display=='flex'){const y=$('pnb').scrollTop;render();$('pnb').scrollTop=y}}}
})();

/* ===== kamera ===== */
let az=0,pol=.75,rad=30,tg=new T.Vector3(-4,0,0),P=new Map(),multi=false,dn=null;
function upd(){pol=Math.min(1.4,Math.max(.03,pol));rad=Math.min(80,Math.max(8,rad));cam.position.set(tg.x+rad*Math.sin(pol)*Math.sin(az),rad*Math.cos(pol),tg.z+rad*Math.sin(pol)*Math.cos(az));cam.lookAt(tg)}
function pan(dx,dy){const k=rad*.0018;tg.x+=-Math.sin(az)*dy*k-Math.cos(az)*dx*k;tg.z+=-Math.cos(az)*dy*k+Math.sin(az)*dx*k}
const cv=R.domElement;
cv.addEventListener('pointerdown',e=>{cv.setPointerCapture(e.pointerId);P.set(e.pointerId,[e.clientX,e.clientY]);if(P.size>1)multi=true;else{multi=false;dn=[e.clientX,e.clientY,performance.now()]}});
cv.addEventListener('pointerup',e=>{const was=P.size;P.delete(e.pointerId);if(mode=='game'&&was==1&&!multi&&dn&&Math.hypot(e.clientX-dn[0],e.clientY-dn[1])<10&&performance.now()-dn[2]<600)pick(e.clientX,e.clientY)});
cv.addEventListener('pointercancel',e=>P.delete(e.pointerId));cv.addEventListener('contextmenu',e=>e.preventDefault());
cv.addEventListener('pointermove',e=>{const o=P.get(e.pointerId);if(!o)return;const n=[e.clientX,e.clientY],dx=n[0]-o[0],dy=n[1]-o[1];
 if(mode=='create'){if(pvChar)pvChar.rotation.y+=dx*.012;P.set(e.pointerId,n);return}
 if(P.size==1){if(e.buttons&2||e.shiftKey)pan(dx,dy);else{az-=dx*.006;pol-=dy*.006}}
 else if(P.size==2){const t=[...P.entries()].find(([k])=>k!=e.pointerId)[1],d0=Math.hypot(o[0]-t[0],o[1]-t[1]),d1=Math.hypot(n[0]-t[0],n[1]-t[1]);if(d1>5)rad*=d0/d1;pan(dx/2,dy/2)}
 P.set(e.pointerId,n);upd()});
cv.addEventListener('wheel',e=>{e.preventDefault();rad*=1+e.deltaY*.001;upd()},{passive:false});
function fit(){const w=innerWidth,h=innerHeight,a=w/h;R.setSize(w,h);cam.aspect=a;cam.updateProjectionMatrix();ccam.aspect=a;
 if(a>1)ccam.setViewOffset(w,h,w*.24,0,w,h);else ccam.setViewOffset(w,h,0,h*.22,w,h);ccam.updateProjectionMatrix();rad=Math.min(70,Math.max(26,22/Math.min(a,1.6)+(a<1?12/a:0)));upd()}
addEventListener('resize',fit);

/* ===== loop ===== */
let last=performance.now(),sec=0,sv=0;
function frame(now){requestAnimationFrame(frame);const dt=Math.min(.1,(now-last)/1000);last=now;clock+=dt;
 if(mode=='create'){R.setScissorTest(false);R.render(pv,ccam);return}
 cool=Math.max(0,cool-dt);boost=Math.max(0,boost-dt);let inc=0;
 emps.forEach(e=>{updE(e,dt);const r=rate(e);inc+=r;coins+=r*dt;earned+=r*dt;xp+=0;e.acc+=r*dt;if(e.acc>=Math.max(2,r*4)){pop(e.g.position.x,2.5,e.g.position.z,'+'+Math.floor(e.acc));addXp(e.acc/6);e.acc=0}});
 WL.forEach(w=>{const lo=w.sh||(!window.SOLIDW&&((cam.position.x-w.cx)*w.nx+(cam.position.z-w.cz)*w.nz>0));
const ts=w.sh?.35:1,to=(!w.sh&&lo)?.12:1,k=Math.min(1,dt*8);
w.g.scale.y+=(ts-w.g.scale.y)*k;
if(!w.mc){w.mc=[];w.op=1;w.g.traverse(o=>{if(o.isMesh&&o.material&&!Array.isArray(o.material)){o.material=o.material.clone();o.material.userData.o0=o.material.opacity;w.mc.push(o.material)}})}
w.op+=(to-w.op)*k;
w.mc.forEach(m=>{const tr=w.op<.99||m.userData.o0<1;if(m.transparent!==tr){m.transparent=tr;m.needsUpdate=true}m.opacity=m.userData.o0*w.op;m.depthWrite=w.op>.5||m.userData.o0>=1&&w.op>.99})});
 rooms.forEach((r,i)=>{if(!owned[i])r.lk.position.y=1.8+Math.sin(clock*2+i)*.12});slots.forEach(s=>{if(s.mk.visible)s.mk.children[1].position.y=1.3+Math.sin(clock*3)*.1});
 pb.position.set(boss.g.position.x,2.75+Math.sin(clock*3)*.1,boss.g.position.z);pb.rotation.y+=dt*2;if(pvChar)pvChar.rotation.y=Math.sin(clock*.6)*.3;
 sec+=dt;if(sec>=1){sec=0;tickApps();$('cn').textContent=Math.floor(coins);$('gn').textContent=gems;$('lvn').textContent=lvl;$('lv').style.background='conic-gradient(#38c6ff '+(xp/(lvl*150)*100)+'%,#12365c 0)';$('eb').style.width=boss.energy+'%';
  $('dot').style.display=Q.some((q,i)=>q[1]()&&!claimed[i])?'block':'none';$('ab').innerHTML=boost>0?'<b>'+Math.ceil(boost)+'</b>':ICO.spark;if(sel&&$('ebar'))$('ebar').textContent=Math.round(sel.energy);if(++sv>=5){sv=0;save()}}
 R.setScissorTest(false);R.setViewport(0,0,innerWidth,innerHeight);R.render(sc,cam);
 if(document.body.classList.contains('pt')){const b=$('port').getBoundingClientRect();pcam.aspect=b.width/b.height;pcam.updateProjectionMatrix();R.autoClear=false;R.setScissorTest(true);R.setViewport(b.left,innerHeight-b.bottom,b.width,b.height);R.setScissor(b.left,innerHeight-b.bottom,b.width,b.height);R.clearDepth();R.render(pv,pcam);R.setScissorTest(false);R.setViewport(0,0,innerWidth,innerHeight);R.autoClear=true}}
fit();
if(saved&&saved.me){Object.assign(me,saved.me);coins=saved.coins;gems=saved.gems;xp=saved.xp;lvl=saved.lvl;earned=saved.earned||0;clock=saved.clock||0;saved.owned.forEach((v,i)=>owned[i]=v);Object.assign(items,saved.items);claimed=saved.claimed||[];flags=saved.flags||{};if(saved.rl)saved.rl.forEach((v,i)=>RL[i]=v);apps=saved.apps||[];nextApp=saved.nextApp||0;appId=saved.appId||1;startGame(saved)}
else{buildCr();rebuild()}
requestAnimationFrame(frame);
</script>
<style id="skin">
:root{--nv:#07203c;--nv2:#0c2d52;--cy:#38c6ff;--cyd:#1a8fd0;--gl:rgba(56,198,255,.5);--bd:rgba(70,175,235,.65);--tx:#e8f6ff}
html,body{background:#0a2a4a;font-family:'Segoe UI',system-ui,Roboto,'Helvetica Neue',sans-serif}
svg{display:block}
/* tombol bulat/kotak gelap */
.rb{width:38px;height:38px;border-radius:12px;border:1.5px solid var(--bd);background:linear-gradient(#10365e,#08223f);color:#fff;font-size:19px;box-shadow:0 2px 8px rgba(0,0,0,.45),inset 0 1px 0 rgba(255,255,255,.12);backdrop-filter:none;padding:0;display:grid;place-items:center}
.rb:active{filter:brightness(1.3)}
.rb b{width:9px;height:9px;top:3px;right:3px;background:var(--cy);border:0;box-shadow:0 0 6px var(--cy)}
/* HUD atas */
#hud{gap:0;top:calc(env(safe-area-inset-top,0px) + 8px)}
#lv{position:relative;z-index:2;width:42px;height:42px;font-size:17px;background:conic-gradient(var(--cy) 0%,#12365c 0);box-shadow:0 0 12px var(--gl),0 2px 6px rgba(0,0,0,.5)}
#lv span{width:33px;height:33px;background:radial-gradient(#10365e,#071c36);color:#fff}
.cap{display:flex;align-items:center;margin-left:-14px;padding-left:16px;height:32px;border-radius:18px;border:1.5px solid var(--bd);background:linear-gradient(#0e3358,#071d38);box-shadow:0 2px 8px rgba(0,0,0,.45),inset 0 1px 0 rgba(255,255,255,.1)}
.seg{display:flex;align-items:center;gap:5px;padding:0 4px 0 2px;color:#fff;font-weight:800;font-size:15px}
.seg+.seg{border-left:1px solid rgba(120,190,240,.3);margin-left:2px;padding-left:8px}
.seg i{width:24px;height:24px;border-radius:50%;display:grid;place-items:center;font-style:normal;font-size:15px;font-weight:900;color:#fff;background:radial-gradient(circle at 35% 30%,#7be35a,#2f9e1b);box-shadow:0 0 0 1.5px #bff5a8 inset}
.seg i.gm{background:none;box-shadow:none;font-size:22px;width:24px;height:24px}
.seg .pl{width:22px;height:22px;border-radius:50%;border:0;background:radial-gradient(circle at 35% 30%,#4cc4ff,#1274c8);color:#fff;font-size:17px;font-weight:900;line-height:1;padding:0;margin-left:2px;box-shadow:0 0 6px rgba(56,198,255,.6)}
#bank{margin-left:8px;border-radius:50%;width:36px;height:36px;font-size:20px;color:#d8f1ff}
/* kolom kiri */
#lc{left:8px;top:calc(env(safe-area-inset-top,0px) + 8px);gap:7px}
/* bar aksi kiri-bawah */
#acts{left:8px;bottom:8px;display:flex;gap:0;padding:3px;border-radius:16px;border:1.5px solid var(--bd);background:linear-gradient(#0e3358,#071d38);box-shadow:0 2px 10px rgba(0,0,0,.5)}
#acts .gr,#acts #ab{width:42px;height:38px;border:0;border-radius:12px;background:none;box-shadow:none;color:#e6f6ff;font-size:23px;display:grid;place-items:center;grid-column:auto;grid-row:auto}
#acts .gr+.gr,#acts .gr+#ab{border-left:1px solid rgba(120,190,240,.25);border-radius:0}
#acts #ab b{font-size:16px}
body.pt #acts{left:112px}
/* tab kanan-bawah */
#tabs{right:8px;bottom:8px;gap:3px;padding:3px;border-radius:16px;border:1.5px solid var(--bd);background:linear-gradient(#0e3358,#071d38);box-shadow:0 2px 10px rgba(0,0,0,.5);backdrop-filter:none}
.tb{width:38px;height:38px;border-radius:12px;background:none;color:#e6f6ff;font-size:23px;display:grid;place-items:center}
.tb.on{background:linear-gradient(#37b8ff,#1272c6);box-shadow:0 0 10px var(--gl),inset 0 1px 0 rgba(255,255,255,.35)}
#bd{top:-3px;right:-3px;background:#ff4a4a;border:1.5px solid #fff}
#toast{color:#fff;text-shadow:none}
#toast.s{display:inline-block}
/* ===== panel (toko perabot, toko ruangan, sheet) ===== */
#shop,#pn,#sheet{background:linear-gradient(#0c2f55,#071f3b);border:1.5px solid var(--cy);border-radius:18px;box-shadow:0 0 0 1px rgba(0,0,0,.4),0 0 22px var(--gl),0 10px 30px rgba(0,0,0,.55);color:var(--tx)}
#shop,#pn{right:8px;top:calc(env(safe-area-inset-top,0px) + 50px);bottom:56px;width:min(42vw,390px);min-width:300px;max-width:calc(100vw - 16px)}
#shh,#pnh{display:flex;align-items:center;gap:10px;background:linear-gradient(#0f3a66,#0a2b4f);color:#fff;font-weight:800;font-size:17px;letter-spacing:.02em;text-transform:uppercase;padding:8px 10px;position:relative;text-align:left;border-bottom:1px solid rgba(80,180,240,.35)}
#shh #sht,#pnh #pnt{flex:1}
#shh button,#pnh #hi{position:static;transform:none;width:38px;height:38px;border-radius:12px;border:1.5px solid var(--bd);background:linear-gradient(#134a7e,#0a2f55);color:#fff;font-size:20px;padding:0;display:grid;place-items:center;box-shadow:inset 0 1px 0 rgba(255,255,255,.15),0 0 10px rgba(56,198,255,.25)}
#pnx,#sheet #x{position:static;transform:none;width:34px;height:34px;border-radius:50%;border:1.5px solid rgba(255,255,255,.75);background:linear-gradient(#10365e,#08223f);color:#fff;font-size:17px;padding:0;display:grid;place-items:center;box-shadow:none}
#pnx,#shx{margin-left:auto}
#shx{width:34px;height:34px;border-radius:50%;border:1.5px solid rgba(255,255,255,.75);background:linear-gradient(#10365e,#08223f);color:#fff;font-size:17px;padding:0;display:grid;place-items:center;flex:none}
/* grid toko perabot */
#shg{grid-template-columns:repeat(4,1fr);gap:7px;padding:9px;align-content:start}
.fcd{position:relative;min-height:84px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;background:linear-gradient(#17508a,#0c3562);border:1.5px solid var(--bd);border-radius:13px;padding:6px 3px;color:#fff;font-size:11.5px;font-weight:700;line-height:1.15;box-shadow:inset 0 1px 0 rgba(255,255,255,.14)}
.fcd i{background:none;border-radius:0;margin:0;font-size:30px;line-height:1.1;position:relative}
.fcd u{color:#ffd45e;font-weight:800;font-size:11px}.fcd u.v{color:var(--cy)}.fcd u.y{color:#ffc94a}
.fcd.or{background:linear-gradient(#d18a30,#9a5a18);border-color:#f0b35a}
.fcd.lk{opacity:1;filter:none;background:linear-gradient(#34475b,#243344);border-color:rgba(150,170,190,.5);color:#c4d0dc}
.fcd.lk i{filter:grayscale(1);opacity:.55}
.fcd.lk i::after{content:'🔒';position:absolute;right:-6px;bottom:-2px;font-size:15px;filter:none;opacity:1}
.fcd:active{filter:brightness(1.2)}
/* panel toko ruangan */
#pnt2{display:flex;gap:6px;padding:8px 8px 0;background:none}
#pnt2 button{flex:1;display:flex;align-items:center;justify-content:center;gap:5px;border:1.5px solid rgba(80,160,220,.45);border-radius:12px;background:linear-gradient(#0d3257,#08223f);color:#a9cce6;font-weight:700;font-size:13px;padding:8px 2px;white-space:nowrap}
#pnt2 button.on{background:linear-gradient(#123f70,#0a2c52);border-color:var(--cy);color:#fff;box-shadow:0 0 12px var(--gl),inset 0 -2px 0 var(--cy)}
#pnt2 button .rd{width:7px;height:7px;border-radius:50%;background:#ff4a4a;margin-left:-2px;align-self:flex-start}
#pnb{padding:8px;gap:8px}
.rcd{background:linear-gradient(#0f3560,#09284a);border:1.5px solid rgba(70,170,230,.5);border-radius:14px;padding:8px;gap:10px;color:#fff;box-shadow:inset 0 1px 0 rgba(255,255,255,.08)}
.rcd.lk{background:linear-gradient(#233549,#192737);border-color:rgba(140,160,185,.4)}
.rcd>svg:first-child{width:86px;height:80px;background:radial-gradient(#15477b,#0a2646);border:1px solid rgba(80,170,230,.4);border-radius:12px;padding:3px;flex:none}
.rin{color:#fff}.rin b{font-size:15.5px;color:#fff}
.rin small{color:#bcd9ee;font-size:11.5px;margin:3px 0}
#pnb small[style]{color:#9cc3de!important}
.st{color:#ffc21a;letter-spacing:1px;margin-left:2px}
.pb{white-space:nowrap;display:inline-flex;align-items:center;justify-content:center;gap:5px;border:1.5px solid rgba(120,215,255,.7);border-radius:11px;background:linear-gradient(#1fa8ff,#0b6fd0);color:#fff;font-weight:800;font-size:13.5px;padding:8px 13px;margin:4px 6px 0 0;box-shadow:0 2px 6px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.3);min-height:34px}
.pb svg{font-size:15px}
.pb.b{background:linear-gradient(#1fa8ff,#0b6fd0);box-shadow:0 2px 6px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.3)}
.pb.g{background:linear-gradient(#3d5973,#2a3f55);border-color:rgba(160,190,215,.55);color:#e6f1fa;box-shadow:inset 0 1px 0 rgba(255,255,255,.12)}
.pb.r{background:linear-gradient(#e0405a,#a8203a);border-color:#ff9aa8}
.pb:disabled{filter:grayscale(.9) brightness(.8);opacity:.6}
#pnb select{background:#0a2a4a;color:#fff;border:1.5px solid var(--bd);border-radius:9px;padding:7px;font-size:12.5px}
/* sheet (menu, misi, dll.) */
#sheet{width:min(54vw,400px);min-width:300px;max-height:78vh;padding:12px 14px 14px;gap:9px;overflow:auto}
#sheet>b{display:flex;align-items:center;gap:10px;font-size:22px;font-weight:700;color:#fff;padding:0 44px 8px 0;border-bottom:1px solid rgba(80,170,230,.3)}
#sheet>b .dots{color:var(--cy);font-size:20px;letter-spacing:-1px}
#sheet #x{position:absolute;top:10px;right:12px}
#sheet p{color:#bcd9ee;font-size:15px;margin:0}
#sheet button:not(#x){display:flex;align-items:center;gap:12px;text-align:left;border:1.5px solid var(--cy);border-radius:12px;background:linear-gradient(#0e4170,#08294b);color:#fff;font-weight:600;font-size:16px;padding:0 14px;min-height:46px;box-shadow:0 0 10px rgba(56,198,255,.25),inset 0 1px 0 rgba(255,255,255,.1)}
#sheet button:not(#x) .ic{font-size:24px;color:#d6f0ff;display:grid;place-items:center;width:30px}
#sheet button:not(#x) .tx{flex:1}
#sheet button:not(#x)::after{content:'›';font-size:26px;color:#d6f0ff;line-height:1;margin-top:-3px}
#sheet button.dg:not(#x){border-color:#e8506a;background:linear-gradient(#5a1d33,#3a1121);box-shadow:0 0 10px rgba(232,80,106,.3)}
#sheet button.dg:not(#x) .ic,#sheet button.dg:not(#x)::after{color:#ff8097}
#sheet button:disabled{filter:grayscale(.8);opacity:.5}
/* buat karakter */
#cp{background:linear-gradient(#0c2f55,#071f3b);border:1.5px solid var(--cy);border-radius:18px;box-shadow:0 0 22px var(--gl);color:#fff}
#tt button{background:#0d3257;color:#bfe3ff;border:1.5px solid rgba(80,160,220,.4);border-bottom:0}#tt button.on{background:linear-gradient(#1f9ae0,#0e6bbd);color:#fff}
#pc h4{color:#8fcdf5;letter-spacing:.08em;font-size:12px}
#pc input{background:#0a2a4a;border:1.5px solid var(--bd);color:#fff}
.sw{border:2px solid rgba(255,255,255,.8)}.sw.on{border-color:var(--cy);box-shadow:0 0 0 2px var(--cy),0 0 10px var(--cy)}
#cr .ck{border:2px solid #bff5a8;background:radial-gradient(circle at 35% 30%,#7be35a,#2f9e1b);box-shadow:0 0 14px rgba(123,227,90,.5)}
#cr .dice{border:1.5px solid var(--bd);background:linear-gradient(#10365e,#08223f)}
/* cincin edit perabot & mode lain */
#ftag{background:linear-gradient(#0f3a66,#0a2b4f);color:#fff;border:1.5px solid var(--cy);box-shadow:0 0 10px var(--gl)}
#rmb,#plb{background:linear-gradient(#0f3a66,#0a2b4f);border:1.5px solid var(--cy);box-shadow:0 0 14px var(--gl);color:#fff}
#rmp{background:linear-gradient(#0f3a66,#0a2b4f);color:#ffd45e;border:1.5px solid var(--cy)}
#rmx{background:linear-gradient(#10365e,#08223f)}
#rot{background:#07203c}
</style>
<script>
(function(){
try{window.SOLIDW=localStorage.getItem('solidw')==='1'}catch(e){window.SOLIDW=false}
const b=document.createElement('button');
b.id='solidbtn';
b.innerHTML='<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg>';
b.style.cssText='position:fixed;left:8px;top:178px;width:44px;height:44px;border-radius:14px;border:2px solid #2a7fd4;color:#fff;z-index:50;display:flex;align-items:center;justify-content:center;padding:0';
function paint(){b.style.background=window.SOLIDW?'#1e88e5':'#0b2a55'}
paint();
b.onclick=function(){window.SOLIDW=!window.SOLIDW;try{localStorage.setItem('solidw',window.SOLIDW?'1':'0')}catch(e){}paint();if(typeof toast==='function')toast(window.SOLIDW?'Dinding selalu solid':'Dinding transparan otomatis')};
document.body.appendChild(b);
})();
</script></body></html>
