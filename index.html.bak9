<!DOCTYPE html>
<html lang="id"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Kantor AI Sims</title>
<link rel="manifest" href="manifest.webmanifest">
<meta name="theme-color" content="#0a2a4a">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<link rel="icon" href="icon-192.png"><link rel="apple-touch-icon" href="icon-192.png">
<style>
:root{box-sizing:border-box;--tx:#0c4a73}
html,body{margin:0;height:100%;overflow:hidden;background:#3fb0ff;font-family:system-ui,sans-serif;user-select:none}
canvas{display:block;width:100%;height:100%;touch-action:none}
.f{position:fixed}button{font-family:inherit;cursor:pointer}
body.cr #hud,body.cr #lc,body.cr #port,body.cr #acts,body.cr #tabs{display:none}body:not(.cr) #cr{display:none}
.pill{display:flex;align-items:center;gap:6px;background:rgba(0,40,70,.6);color:#fff;border-radius:20px;padding:3px 12px 3px 3px;font-weight:800;font-size:15px}
.pill i{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font-style:normal;background:#5ccc2e;border:2px solid #fff}
#hud{top:calc(env(safe-area-inset-top,0px) + 8px);left:0;right:0;display:flex;gap:8px;justify-content:center;align-items:center;pointer-events:none}
#hud>*{pointer-events:auto}
#lv{width:54px;height:54px;border-radius:50%;display:grid;place-items:center;font-weight:900;font-size:22px;color:#fff;background:conic-gradient(#7de35a 0%,#fff 0)}
#lv span{width:42px;height:42px;border-radius:50%;background:#1e7fc0;display:grid;place-items:center}
.rb{width:48px;height:48px;border-radius:50%;border:3px solid #fff;background:#3b9bd8;color:#fff;font-size:22px;display:grid;place-items:center;padding:0;position:relative}
.rb b{position:absolute;top:-2px;right:-2px;width:14px;height:14px;border-radius:50%;background:#f33;border:2px solid #fff;display:none}
#lc{left:10px;top:calc(env(safe-area-inset-top,0px) + 8px);display:flex;flex-direction:column;gap:8px}
#port{left:0;bottom:0;width:150px;height:210px;pointer-events:none}
#bars{position:absolute;left:6px;bottom:6px;right:6px;height:8px;background:#0006;border-radius:4px;overflow:hidden}#eb{height:100%;width:100%;background:#7de35a}
#acts{left:150px;bottom:14px;display:grid;grid-template-columns:repeat(3,58px);gap:6px;align-items:center}
.gr{height:52px;border-radius:12px;border:3px solid #fff;background:linear-gradient(#7fe05a,#3fb02a);font-size:22px;padding:0;box-shadow:0 3px 0 #2a7d1c}
#ab{grid-column:4;grid-row:1/3;width:64px;height:112px;border-radius:14px;border:3px solid #fff;background:linear-gradient(#3fb7ff,#1273c4);color:#fff;font-size:26px;font-weight:800;padding:0;box-shadow:0 3px 0 #0b4f8c}
#tabs{right:10px;bottom:10px;display:flex;gap:4px;background:#fff;border-radius:18px;padding:6px;box-shadow:0 3px 8px #0004}
.tb{width:56px;height:56px;border:0;border-radius:12px;font-size:26px;color:#fff;padding:0}
#sheet{left:50%;top:50%;transform:translate(-50%,-50%);width:min(92vw,420px);max-height:72vh;overflow:auto;background:#e8f5ff;color:var(--tx);border:4px solid #fff;border-radius:20px;padding:14px;display:none;flex-direction:column;gap:8px;box-shadow:0 6px 24px #0007}
#sheet b{font-size:18px}#sheet p{margin:0;font-size:14px}
#sheet button{border:3px solid #fff;border-radius:14px;background:linear-gradient(#7fe05a,#3fb02a);color:#fff;font-weight:800;font-size:14px;padding:10px;box-shadow:0 3px 0 #2a7d1c}
#sheet button:disabled{filter:grayscale(1);opacity:.6}#sheet #x{position:absolute;top:6px;right:8px;background:none;border:0;box-shadow:none;color:var(--tx);font-size:20px;padding:2px 8px}
#toast{top:calc(env(safe-area-inset-top,0px) + 70px);left:0;right:0;text-align:center;pointer-events:none;color:#fff;font-weight:800;text-shadow:0 2px 4px #000a;opacity:0;transition:opacity .3s;font-size:15px}
.pop{position:fixed;color:#fff36a;font-weight:900;font-size:18px;text-shadow:0 2px 3px #000a;pointer-events:none;animation:up 1.4s forwards}
@keyframes up{to{transform:translateY(-44px);opacity:0}}
/* creator */
#cr .ck{position:fixed;left:14px;top:calc(env(safe-area-inset-top,0px) + 12px);width:70px;height:70px;border-radius:50%;border:4px solid #fff;background:#52b81f;color:#fff;font-size:38px;padding:0}
#cr .dice{position:fixed;left:14px;bottom:14px;width:60px;height:60px;border-radius:50%;border:3px solid #fff;background:#3b9bd8;color:#fff;font-size:28px;padding:0}
#cp{position:fixed;right:12px;top:calc(env(safe-area-inset-top,0px) + 10px);bottom:12px;width:min(46vw,380px);background:#d4ecff;border:4px solid #fff;border-radius:22px;display:flex;flex-direction:column;overflow:hidden;color:var(--tx)}
#tt{display:flex;gap:4px;padding:6px 6px 0}#tt button{flex:1;border:0;border-radius:12px 12px 0 0;background:#fff;padding:8px;font-size:20px}#tt button.on{background:#0a6fa6;color:#fff}
#pc{padding:8px 12px;overflow:auto;flex:1}#pc h4{margin:10px 0 4px;text-align:center;font-size:14px}
#pc input{width:100%;box-sizing:border-box;background:#127fc6;color:#fff;border:0;border-radius:8px;padding:10px;font-size:17px}
.sr{display:flex;gap:6px;flex-wrap:wrap;justify-content:center}.sw{width:46px;height:40px;border-radius:10px;border:3px solid #fff;font-weight:800;font-size:18px;color:#fff;background:#7a8a9a;padding:0}.sw.on{border-color:#52d11f;box-shadow:0 0 0 2px #52d11f}
@media (max-aspect-ratio:1/1){#port{width:92px;height:130px;bottom:68px}#acts{left:96px;bottom:74px;grid-template-columns:repeat(4,46px)}.gr{height:44px;font-size:18px}#ab{width:46px;height:44px;grid-column:4;grid-row:1;font-size:20px}
#tabs{left:8px;right:8px;justify-content:center}.tb{width:50px;height:50px}#cp{left:8px;right:8px;top:auto;height:52vh;width:auto}}
#rot{position:fixed;inset:0;z-index:99;background:#0c4a73;color:#fff;display:none;flex-direction:column;align-items:center;justify-content:center;gap:14px;text-align:center;font-weight:800;font-size:18px}
#rot i{font-style:normal;font-size:64px;animation:rt 1.6s ease-in-out infinite}@keyframes rt{50%{transform:rotate(-90deg)}}
@media (orientation:portrait){#rot{display:flex}}
/* HUD minimalis & kecil */
.pill{gap:4px;background:rgba(10,30,50,.45);border-radius:14px;padding:2px 9px 2px 2px;font-size:12px;font-weight:700;backdrop-filter:blur(4px)}
.pill i{width:20px;height:20px;border:0;font-size:11px}
#hud{top:calc(env(safe-area-inset-top,0px) + 6px);gap:6px}
#lv{width:34px;height:34px;font-size:14px}#lv span{width:26px;height:26px}
.rb{width:34px;height:34px;border:2px solid rgba(255,255,255,.85);background:rgba(10,30,50,.45);font-size:15px;backdrop-filter:blur(4px)}
.rb b{width:9px;height:9px;border-width:1px;top:0;right:0}
#lc{left:8px;top:calc(env(safe-area-inset-top,0px) + 6px);gap:6px}
#port{display:none;width:96px;height:140px;bottom:8px;left:8px}body.pt #port{display:block}
#acts{left:8px;bottom:8px;grid-template-columns:repeat(4,36px);gap:5px}body.pt #acts{left:112px}
.gr,#ab{height:34px;width:36px;border-radius:10px;border:2px solid rgba(255,255,255,.85);background:rgba(10,30,50,.45);font-size:15px;box-shadow:none;color:#fff}
#ab{grid-column:4;grid-row:1}
#tabs{right:8px;bottom:8px;gap:3px;padding:4px;border-radius:14px;background:rgba(10,30,50,.45);box-shadow:none;backdrop-filter:blur(4px)}
.tb{width:34px;height:34px;border-radius:10px;font-size:16px}
#toast{top:calc(env(safe-area-inset-top,0px) + 46px);font-size:13px}
/* fitur baru: panel toko ruangan/pelamar/tim */
#pn{position:fixed;right:10px;top:calc(env(safe-area-inset-top,0px) + 48px);bottom:56px;width:min(66vw,520px);background:#e8f5ff;border:4px solid #fff;border-radius:18px;z-index:16;display:none;flex-direction:column;overflow:hidden;box-shadow:0 6px 20px #0007;color:#0c4a73}
#pnh{background:#1c7fb8;color:#fff;text-align:center;font-weight:800;padding:10px 46px;position:relative;text-transform:uppercase;font-size:14px}
#pnx{position:absolute;right:6px;top:50%;transform:translateY(-50%);width:34px;height:34px;border-radius:50%;background:#e53935;border:3px solid #fff;color:#fff;padding:0;font-size:15px}
#pnt2{display:flex;gap:4px;padding:6px 6px 0;background:#cfe8ff}
#pnt2 button{flex:1;border:0;border-radius:10px 10px 0 0;background:#fff;color:#0c4a73;font-weight:800;padding:8px 2px;font-size:13px}#pnt2 button.on{background:#0a6fa6;color:#fff}
#pnb{overflow:auto;padding:8px;display:flex;flex-direction:column;gap:8px;flex:1}
.rcd{display:flex;gap:8px;background:#fff;border:3px solid #b9defa;border-radius:14px;padding:6px;align-items:center}.rcd.lk{background:#eef2f6}
.rcd svg{flex:none}.rin{flex:1;min-width:0;font-size:12px}.rin b{font-size:14px;display:block}.rin small{display:block;color:#4a7a99;margin:2px 0;font-size:11.5px}
.pb{border:2px solid #fff;border-radius:10px;background:linear-gradient(#7fe05a,#3fb02a);color:#fff;font-weight:800;font-size:12px;padding:7px 9px;margin:3px 3px 0 0;box-shadow:0 2px 0 #2a7d1c}.pb.b{background:linear-gradient(#3fb7ff,#1273c4);box-shadow:0 2px 0 #0b4f8c}.pb.r{background:linear-gradient(#ff6b5f,#d32f2f);box-shadow:0 2px 0 #8f1d1d}.pb.g{background:#9aa6b0;box-shadow:none}.pb:disabled{filter:grayscale(1);opacity:.55}
#pnb select{width:100%;padding:6px;border-radius:8px;border:2px solid #9ccbe8;font-size:12px;margin:3px 0;background:#fff;color:#0c4a73}
body.rm #pn,body.pl #pn{display:none!important}
#tbS{position:relative}#bd{position:absolute;top:-5px;right:-5px;min-width:18px;height:18px;border-radius:9px;background:#f33;border:2px solid #fff;color:#fff;font-size:11px;font-weight:800;display:none;place-items:center;padding:0 3px;box-sizing:border-box}
</style></head><body class="cr">
<canvas id="c"></canvas>
<div id="rot"><i>📱</i>Putar HP ke mode landscape</div>
<div id="cr"><button class="ck" id="ok">✔</button><button class="dice" id="dice">🎲</button>
<div id="cp"><div id="tt"><button id="t0">🧬</button><button id="t1">👕</button></div><div id="pc"></div></div></div>
<div id="hud" class="f"><div id="lv"><span id="lvn">1</span></div><div class="cap"><div class="seg"><i>$</i><span id="cn">0</span><button class="pl" id="cplus">+</button></div><div class="seg"><i class="gm"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" ><path d="M6.5 4h11l4 5.5L12 21 2.5 9.5z" fill="#ffc21a" stroke="#fff3b0"/><path d="M2.5 9.5h19M9 4l-2 5.5L12 21l5-11.5L15 4" stroke="#e08a00"/></svg></i><span id="gn">0</span><button class="pl" id="gplus">+</button></div></div><button class="rb" id="bank"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" ><path d="M3.5 9 12 4l8.5 5z"/><path d="M5.5 10v7.5M9.5 10v7.5M14.5 10v7.5M18.5 10v7.5M3.5 20h17"/></svg></button></div>
<div id="lc" class="f"><button class="rb" id="clip"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" ><rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4h6v3H9z"/><path d="M9 11h6M9 14.5h6M9 18h4"/></svg><b id="dot"></b></button><button class="rb" id="rl"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" ><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg></button><button class="rb" id="rr"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" ><path d="M15 14l5-5-5-5"/><path d="M20 9H9.5a5.5 5.5 0 0 0 0 11H13"/></svg></button><button class="rb" id="top"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" ><path d="M12 3 20 20l-8-4-8 4z" fill="currentColor"/></svg></button></div>
<div id="port" class="f"><div id="bars"><div id="eb"></div></div></div>
<div id="acts" class="f"><button class="gr" id="aw"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" ><rect x="3.5" y="7.5" width="17" height="12" rx="2"/><path d="M9 7.5V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5v2"/><path d="M3.5 12.5h17M10.5 12.5v2h3v-2"/></svg></button><button class="gr" id="ar"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" ><path d="M5 10h11v5a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5z"/><path d="M16 11.5h1.5a2.5 2.5 0 0 1 0 5H15.5"/><path d="M8 3.5c0 1.5 1.5 1.5 1.5 3M12 3.5c0 1.5 1.5 1.5 1.5 3"/></svg></button><button class="gr" id="ac"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" ><path d="M4 5.5h16v11H11l-4.5 3.5v-3.5H4z"/><path d="M8.5 11h.01M12 11h.01M15.5 11h.01" stroke-width="2.6"/></svg></button><button id="ab"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" ><path d="M12 3c.7 4.6 2.4 6.3 7 7-4.6.7-6.3 2.4-7 7-.7-4.6-2.4-6.3-7-7 4.6-.7 6.3-2.4 7-7z"/><path d="M19 3.5v3M17.5 5h3"/></svg></button></div>
<div id="tabs" class="f"><button class="tb" id="tbB"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" ><path d="M8 3.5h8a1 1 0 0 1 1 1V11H7V4.5a1 1 0 0 1 1-1z"/><path d="M6 11h12v3.5H6z"/><path d="M12 14.5V19M7.5 20.5h9"/></svg></button><button class="tb" id="tbR"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" ><path d="M5 20.5V6l6-2.5v17"/><path d="M11 9h8v11.5"/><path d="M3.5 20.5h17M7.5 8.5h1M7.5 12h1M7.5 15.5h1M14 12.5h1.5M14 16h1.5"/></svg></button><button class="tb" id="tbE"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" ><circle cx="9" cy="8.5" r="3"/><path d="M3.5 19c0-3 2.5-5 5.5-5s5.5 2 5.5 5"/><circle cx="17" cy="9.5" r="2.4"/><path d="M16.5 14.2c2.6-.2 4.5 1.5 4.5 4.3"/></svg></button><button class="tb" id="tbS"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" ><path d="M3 4.5h2.6l2 10.5h9.8l2-7.5H7"/><circle cx="9.5" cy="19.2" r="1.4"/><circle cx="16.5" cy="19.2" r="1.4"/></svg><b id="bd"></b></button><button class="tb" id="tbM"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" ><path d="M5 12h.01M12 12h.01M19 12h.01" stroke-width="3.2"/></svg></button></div>
<div id="sheet" class="f"></div><div id="toast" class="f"></div>
<script src="three.min.js"></script>
<script>if(typeof THREE==='undefined')document.write('<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"><\/script>')</script>
<script>
(function(){var d=document.documentElement;
function lock(){try{if(!document.fullscreenElement&&d.requestFullscreen)d.requestFullscreen({navigationUI:'hide'}).catch(function(){});}catch(e){}
try{screen.orientation.lock('landscape').catch(function(){});}catch(e){}}
addEventListener('pointerdown',lock,{once:true});
if('serviceWorker' in navigator){var had=!!navigator.serviceWorker.controller;navigator.serviceWorker.addEventListener('controllerchange',function(){if(had)location.reload()});addEventListener('load',function(){navigator.serviceWorker.register('sw.js',{updateViaCache:'none'}).catch(function(){})})}})();
</script>
<script>
if(typeof THREE==='undefined'){document.body.innerHTML='<p style="color:#fff;padding:20px;font:16px sans-serif">three.min.js tidak ditemukan. Jalankan ulang setup.sh (butuh internet sekali).</p>';throw new Error('no three')}
const T=THREE,$=id=>document.getElementById(id),rnd=a=>a[Math.floor(Math.random()*a.length)];
const ICO={'clip': '<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" ><rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4h6v3H9z"/><path d="M9 11h6M9 14.5h6M9 18h4"/></svg>', 'undo': '<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" ><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg>', 'redo': '<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" ><path d="M15 14l5-5-5-5"/><path d="M20 9H9.5a5.5 5.5 0 0 0 0 11H13"/></svg>', 'nav': '<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" ><path d="M12 3 20 20l-8-4-8 4z" fill="currentColor"/></svg>', 'bag': '<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" ><rect x="3.5" y="7.5" width="17" height="12" rx="2"/><path d="M9 7.5V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5v2"/><path d="M3.5 12.5h17M10.5 12.5v2h3v-2"/></svg>', 'cup': '<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" ><path d="M5 10h11v5a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5z"/><path d="M16 11.5h1.5a2.5 2.5 0 0 1 0 5H15.5"/><path d="M8 3.5c0 1.5 1.5 1.5 1.5 3M12 3.5c0 1.5 1.5 1.5 1.5 3"/></svg>', 'chat': '<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" ><path d="M4 5.5h16v11H11l-4.5 3.5v-3.5H4z"/><path d="M8.5 11h.01M12 11h.01M15.5 11h.01" stroke-width="2.6"/></svg>', 'spark': '<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stro